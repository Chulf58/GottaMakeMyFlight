# Curated T8 verification catalog for pt_BR.
msgid ""
msgstr ""
"Project-Id-Version: Gotta Make My Flight\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "No flights yet"
msgstr "Sem voos ainda"

msgid "No flights yet: the rating starts when passengers make or miss a flight."
msgstr "Sem voos ainda: a avaliação começa quando passageiros embarcam ou perdem um voo."

msgid "Made it: {share}% ({made} of {count} passenger)"
msgid_plural "Made it: {share}% ({made} of {count} passengers)"
msgstr[0] "Embarcaram: {share}% ({made} de {count} passageiro)"
msgstr[1] "Embarcaram: {share}% ({made} de {count} passageiros)"

msgid "Airport rating: {stars} of {max}"
msgstr "Avaliação do aeroporto: {stars} de {max}"

msgid "Mood: {mood} of {max}"
msgstr "Humor: {mood} de {max}"

msgid "Incident adjustment: {amount} stars"
msgstr "Ajuste de incidentes: {amount} estrelas"

msgid "Days counted: {days} of {window}"
msgstr "Dias contados: {days} de {window}"

msgid "Floor tile. Passengers can only walk and stand on floor."
msgstr "Piso. Passageiros só andam e ficam em cima de piso."

msgid "Drag a rectangle to lay many tiles at once. Everything else is built on floor."
msgstr "Arraste um retângulo para colocar vários pisos de uma vez. Todo o resto é construído sobre piso."

msgid "Land you own. Removing a tile refunds half."
msgstr "Terreno que você possui. Remover um piso reembolsa metade."

msgid "A wall along a tile edge. Passengers cannot cross it and it blocks the view."
msgstr "Uma parede na borda do piso. Passageiros não atravessam e ela bloqueia a visão."

msgid "Drag along a line to build a row. Walls close in the terminal and its rooms."
msgstr "Arraste em linha para construir uma fileira. Paredes fecham o terminal e suas salas."

msgid "One wall per tile edge. Removing it refunds half."
msgstr "Uma parede por borda de piso. Remover reembolsa metade."

msgid "A glass wall. Passengers cannot cross it, but it lets the view through."
msgstr "Uma parede de vidro. Passageiros não atravessam, mas deixa a visão passar."

msgid "Drag along a line like a wall. Screens and decor can be seen through glass."
msgstr "Arraste em linha como uma parede. Telas e decoração podem ser vistas através do vidro."

msgid "Costs more than a plain wall. One per tile edge."
msgstr "Custa mais que uma parede comum. Uma por borda de piso."

msgid "A door in a wall. Passengers walk through it."
msgstr "Uma porta na parede. Passageiros passam por ela."

msgid "Click a wall edge to put a door in the wall."
msgstr "Clique na borda de uma parede para abrir uma porta."

msgid "A plain wall on each side of it."
msgstr "Uma parede comum de cada lado dela."

msgid "The way into the terminal. Passengers come in here from the road and car parks."
msgstr "A entrada do terminal. Passageiros chegam por aqui vindos da rua e dos estacionamentos."

msgid "Place it on the outer edge of the terminal, facing in."
msgstr "Coloque na borda externa do terminal, virada para dentro."

msgid "The outside edge with no floor behind it. Keep the spot in front clear."
msgstr "A borda externa sem piso atrás. Mantenha o espaço na frente livre."

msgid "The way out to the planes. Passengers leave the terminal here to board."
msgstr "A saída para os aviões. Passageiros deixam o terminal por aqui para embarcar."

msgid "Place it on the outer edge. A gate desk links to an exit facing west, north or east."
msgstr "Coloque na borda externa. Um balcão de portão se conecta a uma saída virada para oeste, norte ou leste."

msgid "Where passengers check in and hand over a bag."
msgstr "Onde os passageiros fazem check-in e despacham a bagagem."

msgid "A check-in agent works behind it. A belt from its back edge takes bags to a bag room."
msgstr "Um agente de check-in trabalha atrás dele. Uma esteira na borda traseira leva malas à sala de bagagem."

msgid "An agent hired in Staff, or it stays closed. Keep the spot behind and in front clear."
msgstr "Um agente contratado em Equipe, ou fica fechado. Mantenha a frente e os fundos livres."

msgid "A basic security scanner. Passengers walk through it to be screened."
msgstr "Um scanner de segurança básico. Passageiros passam por ele para inspeção."

msgid "A security officer works beside it. A full lane is faster but costs more."
msgstr "Um agente de segurança trabalha ao lado. Um corredor completo é mais rápido, mas custa mais."

msgid "An officer hired in Staff, or it stays closed. Keep its staff spot and way in clear."
msgstr "Um agente contratado em Equipe, ou fica fechado. Mantenha o posto e a entrada livres."

msgid "A row of seats. Passengers wait here for their flight and their mood recovers."
msgstr "Uma fileira de assentos. Passageiros esperam o voo aqui e recuperam o humor."

msgid "Place it near the gate and turn it. Waiting passengers sit on it."
msgstr "Coloque perto do portão e gire. Passageiros aguardando sentam nela."

msgid "No staff and no upkeep. Add enough seats for the passengers waiting."
msgstr "Sem equipe nem manutenção. Coloque assentos suficientes para quem espera."

msgid "Makes a gate. It links to the nearest free exit facing the planes; the plane parks out from it."
msgstr "Cria um portão. Conecta-se à saída livre mais próxima virada para os aviões; o avião estaciona ali fora."

msgid "Each flight is given a gate. A gate takes the next free letter, starting at A."
msgstr "Cada voo recebe um portão. O portão recebe a próxima letra livre, começando em A."

msgid "Within 4 cells of a free exit facing the planes, with room for the plane. No staff needed."
msgstr "A até 4 células de uma saída livre virada para os aviões, com espaço para a aeronave. Sem equipe."

msgid "A floor screen that entertains passengers waiting in front of it."
msgstr "Uma tela de piso que distrai passageiros esperando na frente dela."

msgid "It covers a fan of floor up to 5 rows ahead. A plain wall blocks it, glass does not."
msgstr "Cobre um leque de piso de até 5 fileiras à frente. Parede comum bloqueia, vidro não."

msgid "Costs upkeep every day, inside a room or not."
msgstr "Tem custo diário de manutenção, dentro de uma sala ou fora."

msgid "Marks floor as a cafe. Hungry passengers eat and drink here and their mood rises."
msgstr "Marca piso como café. Passageiros com fome comem e bebem aqui e recuperam humor."

msgid "Drag a rectangle, then add a counter and a table. Guests order, then sit at the table."
msgstr "Arraste um retângulo, depois adicione um balcão e uma mesa. Clientes pedem e sentam à mesa."

msgid "At least 3x3, with a counter and a table. Needs shop staff, or the counter stays closed."
msgstr "Pelo menos 3x3, com balcão e mesa. Precisa de atendentes, ou o balcão fica fechado."

msgid "The cafe counter, where guests order."
msgstr "O balcão do café, onde os clientes fazem o pedido."

msgid "Place it inside a cafe or restaurant. A server stands there."
msgstr "Coloque dentro de um café ou restaurante. Um atendente fica ali."

msgid "Wholly inside the room. Shop staff hired in Staff, and the spot in front clear."
msgstr "Inteiro dentro da sala. Atendente contratado em Equipe e espaço da frente livre."

msgid "A table with a seat at each end. Cafe guests sit here to eat."
msgstr "Uma mesa com dois lugares nas pontas. Clientes do café sentam aqui para comer."

msgid "It seats two. A guest walks from the counter to a free seat."
msgstr "Acomoda dois clientes. O visitante vai do balcão até um assento livre."

msgid "Inside a cafe. A bar uses bar counters, and a restaurant uses dining tables or booths."
msgstr "Dentro de um café. Um bar usa balcões de bar, e um restaurante usa mesas ou cabines."

msgid "Marks floor as a toilet. Passengers who need one queue and use a stall."
msgstr "Marca piso como banheiro. Passageiros que precisam entram na fila e usam uma cabine."

msgid "Drag a rectangle, then add a stall and a sink inside."
msgstr "Arraste um retângulo, depois adicione uma cabine e uma pia dentro."

msgid "At least 2x3, with a stall and a sink. Each stall costs upkeep every day when ready."
msgstr "Pelo menos 2x3, com cabine e pia. Cada cabine gera manutenção diária quando pronta."

msgid "One toilet stall. One passenger uses it at a time."
msgstr "Uma cabine de banheiro. Um passageiro usa por vez."

msgid "Place it inside a toilet room. A passenger walks in from the cell in front."
msgstr "Coloque dentro de um banheiro. O passageiro entra pela célula da frente."

msgid "Keep the spot in front clear. Costs upkeep every day once its room is ready."
msgstr "Mantenha a frente livre. Gera manutenção diária assim que a sala estiver pronta."

msgid "A sink. A toilet room is not ready without one."
msgstr "Uma pia. O banheiro não fica pronto sem uma."

msgid "Place it inside a toilet room."
msgstr "Coloque dentro de um banheiro."

msgid "Keep the spot in front clear. No upkeep of its own."
msgstr "Mantenha a frente livre. Sem manutenção própria."

msgid "Marks floor as a kiosk, a small shop. Bored passengers browse here and pay."
msgstr "Marca piso como quiosque, uma loja pequena. Passageiros entediados olham e compram aqui."

msgid "Drag a rectangle, then add a counter and display stands. Guests browse at the stands."
msgstr "Arraste um retângulo, depois adicione um balcão e expositores. Clientes escolhem nos expositores."

msgid "At least 3x3, with a counter and a display stand. Shop staff serve at the counter."
msgstr "Pelo menos 3x3, com balcão e expositor. Atendentes atendem no balcão."

msgid "The kiosk's counter, with a till."
msgstr "O balcão do quiosque, com caixa."

msgid "Place it inside a kiosk. A server stands behind it."
msgstr "Coloque dentro de um quiosque. Um atendente fica atrás dele."

msgid "Wholly inside the kiosk. Shop staff hired in Staff, and the spot in front clear."
msgstr "Inteiro dentro do quiosque. Atendente contratado em Equipe e espaço da frente livre."

msgid "Marks floor as a pharmacy. Passengers browse and buy here."
msgstr "Marca piso como farmácia. Passageiros olham e compram aqui."

msgid "Drag a rectangle, then add a counter and a shelf. Passengers browse at the shelf."
msgstr "Arraste um retângulo, depois adicione um balcão e uma prateleira. Passageiros escolhem na prateleira."

msgid "At least 3x3, with a counter and a shelf. Shop staff serve at the counter."
msgstr "Pelo menos 3x3, com balcão e prateleira. Atendentes atendem no balcão."

msgid "Marks floor as a duty free shop. Passengers browse and spend more than in a kiosk."
msgstr "Marca piso como loja duty free. Passageiros olham e gastam mais do que em um quiosque."

msgid "Drag a rectangle, then add a till and shelves. Passengers browse at the shelves."
msgstr "Arraste um retângulo, depois adicione um caixa e prateleiras. Passageiros escolhem nas prateleiras."

msgid "At least 3x4, with a till and a shelf. Shop staff serve at the till."
msgstr "Pelo menos 3x4, com caixa e prateleira. Atendentes atendem no caixa."

msgid "The duty free shop's till."
msgstr "O caixa da loja duty free."

msgid "Place it inside a duty free shop. A server stands behind it."
msgstr "Coloque dentro de uma loja duty free. Um atendente fica atrás dele."

msgid "Wholly inside the shop. Shop staff hired in Staff, and the spot in front clear."
msgstr "Inteiro dentro da loja. Atendente contratado em Equipe e espaço da frente livre."

msgid "A duty free shelf. Each one gives two browse spots."
msgstr "Uma prateleira duty free. Cada uma oferece dois pontos de compra."

msgid "Passengers browse from the cells in front of it."
msgstr "Passageiros olham a partir das células à frente dela."

msgid "Inside a duty free shop. Keep the cells in front clear."
msgstr "Dentro de uma loja duty free. Mantenha as células à frente livres."

msgid "Marks floor as a fashion store. Passengers browse and spend more than in a kiosk."
msgstr "Marca piso como loja de moda. Passageiros olham e gastam mais do que em um quiosque."

msgid "Drag a rectangle, then add a till and clothes rails. Passengers browse at the rails."
msgstr "Arraste um retângulo, depois adicione um caixa e araras. Passageiros escolhem nas araras."

msgid "At least 3x4, with a till and a clothes rail. Shop staff serve at the till."
msgstr "Pelo menos 3x4, com caixa e arara. Atendentes atendem no caixa."

msgid "The fashion store's till."
msgstr "O caixa da loja de moda."

msgid "Place it inside a fashion store. A server stands behind it."
msgstr "Coloque dentro de uma loja de moda. Um atendente fica atrás dele."

msgid "Wholly inside the store. Shop staff hired in Staff, and the spot in front clear."
msgstr "Inteiro dentro da loja. Atendente contratado em Equipe e espaço da frente livre."

msgid "A clothes rail. Each one gives two browse spots."
msgstr "Uma arara de roupas. Cada uma oferece dois pontos de compra."

msgid "Inside a fashion store. Keep the cells in front clear."
msgstr "Dentro de uma loja de moda. Mantenha as células à frente livres."

msgid "Marks floor as a currency exchange. Passengers change money and pay a small fee."
msgstr "Marca piso como casa de câmbio. Passageiros trocam dinheiro e pagam uma pequena taxa."

msgid "Drag a rectangle, then add a counter. A server works it."
msgstr "Arraste um retângulo, depois adicione um balcão. Um atendente trabalha nele."

msgid "At least 2x3, with a counter and shop staff. A visit does not cure boredom."
msgstr "Pelo menos 2x3, com balcão e atendente. A visita não alivia o tédio."

msgid "Marks floor as an ATM room. Passengers take out cash and pay a small fee."
msgstr "Marca piso como sala de caixa eletrônico. Passageiros sacam dinheiro e pagam uma taxa."

msgid "Drag a rectangle, then add an ATM. It is self-service."
msgstr "Arraste um retângulo, depois adicione um caixa eletrônico. É autoatendimento."

msgid "At least 1x2, with an ATM. No staff. A visit does not cure boredom."
msgstr "Pelo menos 1x2, com caixa eletrônico. Sem equipe. A visita não alivia o tédio."

msgid "Marks floor as a bar. Guests stay longer than in a cafe, spend more, and gain most mood."
msgstr "Marca piso como bar. Clientes ficam mais tempo que no café, gastam mais e ganham mais humor."

msgid "Guests order at a bar counter and sit on its stools."
msgstr "Clientes pedem em um balcão de bar e sentam nas banquetas."

msgid "At least 3x4, with a bar counter. Shop staff serve at the counter."
msgstr "Pelo menos 3x4, com balcão de bar. Atendentes atendem no balcão."

msgid "Marks floor as a sit-down restaurant. Guests stay the longest and spend the most."
msgstr "Marca piso como restaurante. Clientes ficam mais tempo e gastam mais."

msgid "Guests order at a cafe counter and sit at a dining table or a booth."
msgstr "Clientes pedem no balcão de café e sentam em uma mesa de jantar ou cabine."

msgid "At least 4x4, with a counter and a table or booth. Shop staff serve at the counter."
msgstr "Pelo menos 4x4, com balcão e mesa ou cabine. Atendentes atendem no balcão."

msgid "Marks floor as a grab-and-go stall. Guests buy, pay and walk on, with no seat."
msgstr "Marca piso como lanchonete rápida. Clientes compram, pagam e seguem andando, sem assento."

msgid "It needs only a grab-and-go stall. A server hands over the order."
msgstr "Precisa apenas de uma barraca rápida. Um atendente entrega o pedido."

msgid "At least 3x3, with a counter. Shop staff serve. It earns the least of the food rooms."
msgstr "Pelo menos 3x3, com balcão. Atendentes atendem. Rende menos que as outras salas de comida."

msgid "Marks floor as a play area. Passengers stay and play for free and their mood rises."
msgstr "Marca piso como área infantil. Passageiros ficam e brincam de graça e o humor sobe."

msgid "Drag a rectangle, then add a slide and play blocks. It is self-service."
msgstr "Arraste um retângulo, depois adicione um escorregador e blocos. É autoatendimento."

msgid "At least 3x4, with a slide and play blocks. No staff."
msgstr "Pelo menos 3x4, com escorregador e blocos de montar. Sem equipe."

msgid "Marks floor as a lounge. Passengers rest on the sofas for free and their mood rises."
msgstr "Marca piso como sala VIP. Passageiros descansam nos sofás de graça e o humor sobe."

msgid "Drag a rectangle, then add a sofa. It is self-service."
msgstr "Arraste um retângulo, depois adicione um sofá. É autoatendimento."

msgid "At least 2x3, with a sofa. No staff."
msgstr "Pelo menos 2x3, com um sofá. Sem equipe."

msgid "Marks floor as a shower room. Passengers pay to wash during a long wait and gain mood."
msgstr "Marca piso como sala de banho. Passageiros pagam para tomar banho em esperas longas e ganham humor."

msgid "Drag a rectangle, then add a shower cubicle. It is self-service."
msgstr "Arraste um retângulo, depois adicione uma cabine de chuveiro. É autoatendimento."

msgid "At least 2x2, with a shower cubicle. No staff. Each stay pays you a fee."
msgstr "Pelo menos 2x2, com cabine de chuveiro. Sem equipe. Cada uso paga uma taxa."

msgid "Marks floor as a nap pod room. Passengers pay to rest during a long wait and gain mood."
msgstr "Marca piso como sala de cápsula de sono. Passageiros pagam para descansar em esperas longas."

msgid "Drag a rectangle, then add a nap pod. It is self-service."
msgstr "Arraste um retângulo, depois adicione uma cápsula de sono. É autoatendimento."

msgid "At least 2x2, with a nap pod. No staff. Each stay pays you a fee."
msgstr "Pelo menos 2x2, com cápsula de sono. Sem equipe. Cada uso paga uma taxa."

msgid "A shelf unit. Each stand gives the kiosk two browse spots."
msgstr "Uma prateleira expositora. Cada unidade dá dois pontos de compra ao quiosque."

msgid "Inside a kiosk. Keep the cells in front clear."
msgstr "Dentro de um quiosque. Mantenha as células à frente livres."

msgid "A baggage belt. It carries checked bags from a check-in desk to a bag room."
msgstr "Uma esteira de bagagem. Leva malas despachadas do balcão de check-in até a sala de bagagem."

msgid "Drag a line. The belt shapes itself at turns and joins. Belts cannot cross."
msgstr "Arraste em linha. A esteira se ajusta em curvas e junções. Esteiras não podem cruzar."

msgid "Start at a check-in desk's back and end in a bag room. A wall in the way blocks it."
msgstr "Comece atrás de um balcão de check-in e termine em uma sala de bagagem. Paredes bloqueiam."

msgid "Where checked bags end up. They are loaded onto the plane from here."
msgstr "Onde as malas despachadas chegam. Elas são levadas para o avião a partir daqui."

msgid "Drag a rectangle, then run a belt into it. The belt's end piece goes inside."
msgstr "Arraste um retângulo e traga uma esteira para dentro. A ponta da esteira fica lá dentro."

msgid "At least 2x2, with a belt end. A bag that arrives after the cutoff misses the plane."
msgstr "Pelo menos 2x2, com ponta de esteira. Mala que chega após o limite perde o voo."

msgid "A baggage cart on wheels."
msgstr "Um carrinho de bagagem com rodas."

msgid "Place one in a bag room so a hired Ramp Agent drives checked bags out to the parked plane."
msgstr "Coloque na sala de bagagem para que um agente de pátio contratado leve as malas até o avião."

msgid "Needs a Ramp Agent hired in Staff. Takes 1x2 tiles; no upkeep."
msgstr "Precisa de agente de pátio contratado em Equipe. Ocupa 1x2 células; sem manutenção."

msgid "A curb bay on the road outside. Cars and taxis stop here and drop passengers off."
msgstr "Uma baia de embarque na via externa. Carros e táxis param aqui para deixar passageiros."

msgid "Click one of the marked spots by the road. Each bay has two berths."
msgstr "Clique em um dos pontos marcados junto à via. Cada baia tem duas vagas."

msgid "Marked spots only. The nearer an entrance, the shorter the walk."
msgstr "Apenas nos pontos marcados. Quanto mais perto da entrada, menor a caminhada."

msgid "A car park with 12 spaces. A car pays a fee when it parks."
msgstr "Um estacionamento com 12 vagas. Cada carro paga uma taxa ao estacionar."

msgid "Click a marked spot. Passengers walk from the car park to an entrance."
msgstr "Clique em um ponto marcado. Passageiros caminham do estacionamento até uma entrada."

msgid "Marked spots only. Close it to let it drain before you remove it."
msgstr "Apenas nos pontos marcados. Feche-o para esvaziar antes de remover."

msgid "A big car park with 31 spaces. A car pays a higher fee than a surface lot when it parks."
msgstr "Um grande estacionamento com 31 vagas. Cada carro paga uma taxa maior que no pátio aberto."

msgid "Opens or closes a car park."
msgstr "Abre ou fecha um estacionamento."

msgid "Click a built car park. A closed one takes no new cars and empties out."
msgstr "Clique em um estacionamento construído. Fechado, não recebe carros novos e esvazia."

msgid "A car park can only be removed once no cars are in it."
msgstr "Um estacionamento só pode ser removido quando não houver mais carros dentro."

msgid "Buys a plot of land. You can only build on land you own."
msgstr "Compra um lote de terreno. Você só pode construir em terrenos seus."

msgid "Click a highlighted plot. Its price shows on it and rises with each plot you buy."
msgstr "Clique em um lote destacado. O preço aparece nele e sobe a cada compra."

msgid "A plot next to land you already own."
msgstr "Um lote vizinho a um terreno que você já possui."

msgid "The tray table of a security lane, where passengers unpack their bags."
msgstr "A mesa de bandejas de um corredor de segurança, onde os passageiros preparam suas malas."

msgid "It stands beside the arch, on the side the lane's parts go."
msgstr "Fica ao lado do arco, no lado em que vão as peças do corredor."

msgid "Part of a whole lane: arch, tray table, X-ray belt and pickup table."
msgstr "Parte de um corredor completo: arco, mesa de bandejas, esteira de raio-X e mesa de retirada."

msgid "The X-ray belt of a security lane. Bags ride through it."
msgstr "A esteira de raio-X de um corredor de segurança. As malas passam por ela."

msgid "It stands beside the arch. A lane officer works at it."
msgstr "Fica ao lado do arco. Um agente do corredor trabalha nela."

msgid "Part of a whole lane. Needs a security officer hired in Staff."
msgstr "Parte de um corredor completo. Precisa de agente de segurança contratado em Equipe."

msgid "The arch of a security lane. Passengers walk through it."
msgstr "O arco de um corredor de segurança. Passageiros passam por ele."

msgid "Place the arch first and the other parts around it. Its front faces the queue."
msgstr "Coloque o arco primeiro e as demais peças em volta. A frente fica voltada para a fila."

msgid "Part of a whole lane. Keep the spot in front and the walls around the lane clear."
msgstr "Parte de um corredor completo. Mantenha a frente e as paredes em volta livres."

msgid "The pickup table of a security lane, where passengers collect their bags."
msgstr "A mesa de retirada de um corredor de segurança, onde os passageiros pegam suas malas."

msgid "It stands past the arch, where cleared passengers leave the lane."
msgstr "Fica depois do arco, onde passageiros liberados deixam o corredor."

msgid "A bush. It calms passengers close to it, a little."
msgstr "Um arbusto. Acalma um pouco os passageiros próximos."

msgid "Passengers within a cell or so get calm, which becomes mood. Walls block it."
msgstr "Passageiros a cerca de uma célula ganham calma, que vira humor. Paredes bloqueiam."

msgid "No upkeep. It earns nothing."
msgstr "Sem manutenção. Não gera renda."

msgid "A planter. It calms passengers near it, a little."
msgstr "Uma jardineira. Acalma um pouco os passageiros próximos."

msgid "Passengers within a couple of cells get calm, which becomes mood. Walls block it."
msgstr "Passageiros a poucas células ganham calma, que vira humor. Paredes bloqueiam."

msgid "A large plant pot. It calms passengers near it, a little."
msgstr "Um vaso grande com planta. Acalma um pouco os passageiros próximos."

msgid "An indoor tree. It calms the passengers around it."
msgstr "Uma árvore interna. Acalma os passageiros ao redor."

msgid "Passengers within a few cells get calm, which becomes mood. Walls block it."
msgstr "Passageiros a algumas células ganham calma, que vira humor. Paredes bloqueiam."

msgid "A bench. It seats two waiting passengers and calms passengers nearby."
msgstr "Um banco. Acomoda dois passageiros esperando e acalma quem está perto."

msgid "Gate passengers sit on it. Calm becomes mood, and a wall between them blocks it."
msgstr "Passageiros do portão sentam nele. Calma vira humor, e uma parede entre eles bloqueia."

msgid "A bench built around a tree. It calms the passengers near it."
msgstr "Um banco em volta de uma árvore. Acalma os passageiros próximos."

msgid "A fountain. It calms the passengers around it the most, with a long reach."
msgstr "Uma fonte. É o item que mais acalma passageiros ao redor, com longo alcance."

msgid "A statue. It calms the passengers around it, with a long reach."
msgstr "Uma estátua. Acalma os passageiros ao redor, com longo alcance."

msgid "A retractable-belt stanchion post. Passengers cannot walk through it."
msgstr "Um pedestal retrátil de fila. Passageiros não passam por ele."

msgid "Use stanchions and queue belts to steer a queue. They give a little calm nearby."
msgstr "Use pedestais e fitas de fila para guiar uma fila. Dão um pouco de calma por perto."

msgid "A queue belt between two stanchions, three cells long. Passengers cannot walk through it."
msgstr "Uma fita de fila entre dois pedestais, com três células. Passageiros não atravessam."

msgid "A bin. Passengers drop litter in it instead of leaving it on the floor."
msgstr "Uma lixeira. Passageiros jogam lixo nela em vez de sujar o piso."

msgid "A bin takes litter from visits near it, and a cleaner empties it when it is full."
msgstr "A lixeira recolhe sujeira de visitas próximas, e um zelador a esvazia quando enche."

msgid "A cleaner hired in Staff. It gives no calm, and a bin in view takes a little back."
msgstr "Zelador contratado em Equipe. Não acalma, e uma lixeira à vista tira um pouco de calma."

msgid "A bar counter, where guests order drinks."
msgstr "Um balcão de bar, onde clientes pedem bebidas."

msgid "Place it inside a bar. A server stands behind it and guests order from the cell in front."
msgstr "Coloque dentro de um bar. Um atendente fica atrás e clientes pedem pela célula da frente."

msgid "Wholly inside the bar. Shop staff hired in Staff, and the spot in front clear."
msgstr "Inteiro dentro do bar. Atendente contratado em Equipe e espaço da frente livre."

msgid "A grab-and-go stall, where guests buy and walk on."
msgstr "Uma barraca rápida, onde clientes compram e seguem andando."

msgid "Place it inside a grab-and-go room. A server hands over the order."
msgstr "Coloque dentro de uma lanchonete rápida. Um atendente entrega o pedido."

msgid "A restaurant table with four seats."
msgstr "Uma mesa de restaurante com quatro lugares."

msgid "Place it inside a restaurant. A guest walks from the counter to a free seat."
msgstr "Coloque dentro de um restaurante. O cliente vai do balcão até um lugar livre."

msgid "Wholly inside the restaurant, with the cell behind each chair clear."
msgstr "Inteira dentro do restaurante, com a célula atrás de cada cadeira livre."

msgid "A restaurant booth with four seats."
msgstr "Uma cabine de restaurante com quatro lugares."

msgid "Wholly inside the restaurant, with the cell behind each seat clear."
msgstr "Inteira dentro do restaurante, com a célula atrás de cada assento livre."

msgid "A staffed desk that helps lost passengers."
msgstr "Um balcão com atendente que ajuda passageiros perdidos."

msgid "A stuck passenger nearby walks over, is helped, gains mood and plans its route again."
msgstr "Um passageiro travado perto vai até lá, recebe ajuda, ganha humor e recalcula a rota."

msgid "Shop staff hired in Staff, or it does nothing. Works on open floor or in a room."
msgstr "Atendente contratado em Equipe, ou não funciona. Atua em piso aberto ou em sala."

msgid "An information display."
msgstr "Um painel de informações."

msgid "Scenery for now: nothing in the game reacts to it."
msgstr "Por enquanto é só cenário: nada no jogo interage com ele."

msgid "Costs upkeep every day."
msgstr "Tem custo diário de manutenção."

msgid "The currency exchange counter."
msgstr "O balcão da casa de câmbio."

msgid "Place it inside an exchange room. A server stands behind it and changes money."
msgstr "Coloque dentro de uma casa de câmbio. Um atendente fica atrás e troca dinheiro."

msgid "A cash machine. One passenger uses it at a time and pays a small fee."
msgstr "Um caixa eletrônico. Um passageiro usa por vez e paga uma pequena taxa."

msgid "Place it inside an ATM room. The passenger uses it from the cell in front."
msgstr "Coloque dentro de uma sala de caixa eletrônico. O passageiro usa pela célula da frente."

msgid "Keep the spot in front clear. No staff and no upkeep."
msgstr "Mantenha a frente livre. Sem equipe e sem manutenção."

msgid "The pharmacy counter, with a till."
msgstr "O balcão da farmácia, com caixa."

msgid "Place it inside a pharmacy. A server stands behind it."
msgstr "Coloque dentro de uma farmácia. Um atendente fica atrás dele."

msgid "Wholly inside the pharmacy. Shop staff hired in Staff, and the spot in front clear."
msgstr "Inteiro dentro da farmácia. Atendente contratado em Equipe e espaço da frente livre."

msgid "A pharmacy shelf. Each one gives one browse spot."
msgstr "Uma prateleira de farmácia. Cada uma oferece um ponto de compra."

msgid "Passengers browse from the cell in front of it."
msgstr "Passageiros olham a partir da célula à frente dela."

msgid "Inside a pharmacy. Keep the cells in front clear."
msgstr "Dentro de uma farmácia. Mantenha as células à frente livres."

msgid "A shower cubicle. One passenger uses it at a time and pays a fee."
msgstr "Uma cabine de chuveiro. Um passageiro usa por vez e paga uma taxa."

msgid "Place it inside a shower room. The passenger steps in from the cell in front."
msgstr "Coloque dentro de uma sala de banho. O passageiro entra pela célula da frente."

msgid "Keep the spot in front clear. No upkeep."
msgstr "Mantenha a frente livre. Sem manutenção."

msgid "A nap pod. One passenger uses it at a time and pays a fee."
msgstr "Uma cápsula de sono. Um passageiro usa por vez e paga uma taxa."

msgid "Place it inside a nap pod room. The passenger sits and leans back."
msgstr "Coloque dentro de uma sala de cápsula de sono. O passageiro senta e reclina."

msgid "A two-seat sofa. Lounge guests rest on it."
msgstr "Um sofá de dois lugares. Visitantes da sala VIP descansam nele."

msgid "Place it inside a lounge. Each sofa gives two seats."
msgstr "Coloque dentro de uma sala VIP. Cada sofá dá dois assentos."

msgid "No upkeep. The lounge is free to use."
msgstr "Sem manutenção. A sala VIP é gratuita."

msgid "A single armchair."
msgstr "Uma poltrona individual."

msgid "A passenger can sit on it, but a lounge needs a sofa. The armchair does not count."
msgstr "Passageiros podem sentar nela, mas uma sala VIP precisa de sofá. A poltrona não conta."

msgid "A work desk."
msgstr "Uma mesa de trabalho."

msgid "Play blocks for children."
msgstr "Blocos de montar para crianças."

msgid "Place them inside a play area. A play area needs them and a slide."
msgstr "Coloque dentro de uma área infantil. A área precisa deles e de um escorregador."

msgid "No upkeep. The play area is free to use."
msgstr "Sem manutenção. A área infantil é gratuita."

msgid "A play slide. Children use it from the front."
msgstr "Um escorregador infantil. Crianças usam pela frente."

msgid "Place it inside a play area. Each slide gives two play spots."
msgstr "Coloque dentro de uma área infantil. Cada escorregador dá dois espaços para brincar."

msgid "A prize car on a podium. Passengers near it spend a bit more in shops and food rooms."
msgstr "Um carro premiado em um pódio. Passageiros por perto gastam um pouco mais em lojas e comida."

msgid "Waiting passengers who see it lose boredom. A second podium does not stack."
msgstr "Passageiros esperando que o veem perdem tédio. Um segundo pódio não acumula."

msgid "Costs upkeep every day. A plain wall blocks the view."
msgstr "Tem custo diário de manutenção. Uma parede comum bloqueia a visão."

