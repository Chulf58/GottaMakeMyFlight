msgstr ""
"Project-Id-Version: Gotta Make My Flight\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "No flights yet"
msgstr "Aucun vol encore"

msgid "No flights yet: the rating starts when passengers make or miss a flight."
msgstr "Aucun vol pour l'instant : la note commence dès que des passagers prennent ou ratent un vol."

msgid "Made it: {share}% ({made} of {count} passenger)"
msgid_plural "Made it: {share}% ({made} of {count} passengers)"
msgstr[0] "Embarqués : {share} % ({made} sur {count} passager)"
msgstr[1] "Embarqués : {share} % ({made} sur {count} passagers)"

msgid "Airport rating: {stars} of {max}"
msgstr "Note de l'aéroport : {stars} sur {max}"

msgid "Mood: {mood} of {max}"
msgstr "Humeur : {mood} sur {max}"

msgid "Incident adjustment: {amount} stars"
msgstr "Ajustement d'incident : {amount} étoiles"

msgid "Days counted: {days} of {window}"
msgstr "Jours comptés : {days} sur {window}"

msgid "Floor tile. Passengers can only walk and stand on floor."
msgstr "Dalle de sol. Les passagers ne peuvent marcher et rester que sur le sol."

msgid "Drag a rectangle to lay many tiles at once. Everything else is built on floor."
msgstr "Glissez un rectangle pour poser plusieurs dalles d'un coup. Tout le reste se construit sur le sol."

msgid "Land you own. Removing a tile refunds half."
msgstr "Terrain qui vous appartient. Retirer une dalle rembourse la moitié."

msgid "A wall along a tile edge. Passengers cannot cross it and it blocks the view."
msgstr "Un mur le long d'un bord de dalle. Les passagers ne peuvent pas le traverser et il bloque la vue."

msgid "Drag along a line to build a row. Walls close in the terminal and its rooms."
msgstr "Glissez en ligne pour bâtir une rangée. Les murs ferment le terminal et ses salles."

msgid "One wall per tile edge. Removing it refunds half."
msgstr "Un mur par bord de dalle. Le retirer rembourse la moitié."

msgid "A glass wall. Passengers cannot cross it, but it lets the view through."
msgstr "Un mur vitré. Les passagers ne peuvent pas le traverser, mais il laisse passer la vue."

msgid "Drag along a line like a wall. Screens and decor can be seen through glass."
msgstr "Glissez en ligne comme un mur. Les écrans et le décor restent visibles à travers le verre."

msgid "Costs more than a plain wall. One per tile edge."
msgstr "Coûte plus cher qu'un mur simple. Un par bord de dalle."

msgid "A door in a wall. Passengers walk through it."
msgstr "Une porte dans un mur. Les passagers passent à travers."

msgid "Click a wall edge to put a door in the wall."
msgstr "Cliquez sur un mur pour y placer une porte."

msgid "A plain wall on each side of it."
msgstr "Un mur simple de chaque côté."

msgid "The way into the terminal. Passengers come in here from the road and car parks."
msgstr "L'entrée du terminal. Les passagers arrivent ici depuis la route et les parkings."

msgid "Place it on the outer edge of the terminal, facing in."
msgstr "Placez-la sur le bord extérieur du terminal, tournée vers l'intérieur."

msgid "The outside edge with no floor behind it. Keep the spot in front clear."
msgstr "Le bord extérieur sans sol derrière. Laissez la case devant libre."

msgid "The way out to the planes. Passengers leave the terminal here to board."
msgstr "La sortie vers les avions. Les passagers quittent le terminal ici pour embarquer."

msgid "Place it on the outer edge. A gate desk links to an exit facing west, north or east."
msgstr "Placez-la sur le bord extérieur. Une porte d'embarq. se lie à une sortie vers l'ouest, le nord ou l'est."

msgid "Where passengers check in and hand over a bag."
msgstr "Là où les passagers s'enregistrent et déposent un bagage."

msgid "A check-in agent works behind it. A belt from its back edge takes bags to a bag room."
msgstr "Un agent d'enreg. y travaille derrière. Un tapis part de l'arrière vers une salle bagages."

msgid "An agent hired in Staff, or it stays closed. Keep the spot behind and in front clear."
msgstr "Un agent embauché dans Personnel, sinon il reste fermé. Gardez l'avant et l'arrière libres."

msgid "A basic security scanner. Passengers walk through it to be screened."
msgstr "Un scanner de sécurité de base. Les passagers le traversent pour être contrôlés."

msgid "A security officer works beside it. A full lane is faster but costs more."
msgstr "Un agent de sécurité travaille à côté. Un couloir complet est plus rapide mais coûte plus cher."

msgid "An officer hired in Staff, or it stays closed. Keep its staff spot and way in clear."
msgstr "Un agent embauché dans Personnel, sinon il reste fermé. Gardez son poste et l'entrée libres."

msgid "A row of seats. Passengers wait here for their flight and their mood recovers."
msgstr "Une rangée de sièges. Les passagers attendent leur vol ici et leur humeur remonte."

msgid "Place it near the gate and turn it. Waiting passengers sit on it."
msgstr "Placez-la près de la porte et orientez-la. Les passagers en attente s'y assoient."

msgid "No staff and no upkeep. Add enough seats for the passengers waiting."
msgstr "Sans personnel ni entretien. Ajoutez assez de sièges pour les passagers en attente."

msgid "Makes a gate. It links to the nearest free exit facing the planes; the plane parks out from it."
msgstr "Crée une porte. Elle se lie à la sortie libre la plus proche face aux avions ; l'avion s'y gare."

msgid "Each flight is given a gate. A gate takes the next free letter, starting at A."
msgstr "Chaque vol reçoit une porte. Une porte prend la lettre libre suivante, en commençant à A."

msgid "Within 4 cells of a free exit facing the planes, with room for the plane. No staff needed."
msgstr "À moins de 4 cases d'une sortie libre face aux avions, avec de la place pour l'avion. Sans personnel."

msgid "A floor screen that entertains passengers waiting in front of it."
msgstr "Un écran au sol qui divertit les passagers qui attendent devant."

msgid "It covers a fan of floor up to 5 rows ahead. A plain wall blocks it, glass does not."
msgstr "Couvre un cône de sol jusqu'à 5 rangées devant. Un mur plein le bloque, pas le verre."

msgid "Costs upkeep every day, inside a room or not."
msgstr "Coûte de l'entretien chaque jour, dans une salle ou non."

msgid "Marks floor as a cafe. Hungry passengers eat and drink here and their mood rises."
msgstr "Marque le sol comme café. Les passagers affamés mangent et boivent ici et leur humeur monte."

msgid "Drag a rectangle, then add a counter and a table. Guests order, then sit at the table."
msgstr "Glissez un rectangle, puis ajoutez un comptoir et une table. Les clients commandent puis s'assoient."

msgid "At least 3x3, with a counter and a table. Needs shop staff, or the counter stays closed."
msgstr "Au moins 3x3, avec un comptoir et une table. Demande des vendeurs, sinon le comptoir reste fermé."

msgid "The cafe counter, where guests order."
msgstr "Le comptoir du café, où les clients commandent."

msgid "Place it inside a cafe or restaurant. A server stands there."
msgstr "Placez-le dans un café ou un restaurant. Un serveur s'y tient."

msgid "Wholly inside the room. Shop staff hired in Staff, and the spot in front clear."
msgstr "Entièrement dans la salle. Vendeurs embauchés dans Personnel, et la case devant libre."

msgid "A table with a seat at each end. Cafe guests sit here to eat."
msgstr "Une table avec un siège à chaque bout. Les clients du café s'y assoient pour manger."

msgid "It seats two. A guest walks from the counter to a free seat."
msgstr "Deux places assises. Le client va du comptoir vers un siège libre."

msgid "Inside a cafe. A bar uses bar counters, and a restaurant uses dining tables or booths."
msgstr "Dans un café. Un bar utilise des comptoirs de bar, et un restaurant des tables à dîner ou des banquettes."

msgid "Marks floor as a toilet. Passengers who need one queue and use a stall."
msgstr "Marque le sol comme toilettes. Les passagers qui en ont besoin font la queue et utilisent une cabine."

msgid "Drag a rectangle, then add a stall and a sink inside."
msgstr "Glissez un rectangle, puis ajoutez une cabine et un lavabo à l'intérieur."

msgid "At least 2x3, with a stall and a sink. Each stall costs upkeep every day when ready."
msgstr "Au moins 2x3, avec une cabine et un lavabo. Chaque cabine coûte de l'entretien par jour une fois prête."

msgid "One toilet stall. One passenger uses it at a time."
msgstr "Une cabine de toilettes. Un seul passager l'utilise à la fois."

msgid "Place it inside a toilet room. A passenger walks in from the cell in front."
msgstr "Placez-la dans des toilettes. Le passager entre par la case devant."

msgid "Keep the spot in front clear. Costs upkeep every day once its room is ready."
msgstr "Gardez la case devant libre. Coûte de l'entretien par jour dès que la salle est prête."

msgid "A sink. A toilet room is not ready without one."
msgstr "Un lavabo. Les toilettes ne sont pas prêtes sans au moins un lavabo."

msgid "Place it inside a toilet room."
msgstr "Placez-le dans une salle de toilettes."

msgid "Keep the spot in front clear. No upkeep of its own."
msgstr "Gardez la case devant libre. Aucun entretien propre."

msgid "Marks floor as a kiosk, a small shop. Bored passengers browse here and pay."
msgstr "Marque le sol comme kiosque, une petite boutique. Les passagers qui s'ennuient flânent et paient."

msgid "Drag a rectangle, then add a counter and display stands. Guests browse at the stands."
msgstr "Glissez un rectangle, puis ajoutez un comptoir et des présentoirs. Les clients regardent aux présentoirs."

msgid "At least 3x3, with a counter and a display stand. Shop staff serve at the counter."
msgstr "Au moins 3x3, avec un comptoir et un présentoir. Les vendeurs servent au comptoir."

msgid "The kiosk's counter, with a till."
msgstr "Le comptoir du kiosque, avec une caisse."

msgid "Place it inside a kiosk. A server stands behind it."
msgstr "Placez-le dans un kiosque. Un vendeur se tient derrière."

msgid "Wholly inside the kiosk. Shop staff hired in Staff, and the spot in front clear."
msgstr "Entièrement dans le kiosque. Vendeurs embauchés dans Personnel, et la case devant libre."

msgid "Marks floor as a pharmacy. Passengers browse and buy here."
msgstr "Marque le sol comme pharmacie. Les passagers y flânent et achètent."

msgid "Drag a rectangle, then add a counter and a shelf. Passengers browse at the shelf."
msgstr "Glissez un rectangle, puis ajoutez un comptoir et un rayon. Les passagers flânent devant le rayon."

msgid "At least 3x3, with a counter and a shelf. Shop staff serve at the counter."
msgstr "Au moins 3x3, avec un comptoir et un rayon. Les vendeurs servent au comptoir."

msgid "Marks floor as a duty free shop. Passengers browse and spend more than in a kiosk."
msgstr "Marque le sol comme boutique duty-free. Les passagers flânent et dépensent plus qu'en kiosque."

msgid "Drag a rectangle, then add a till and shelves. Passengers browse at the shelves."
msgstr "Glissez un rectangle, puis ajoutez une caisse et des rayons. Les passagers flânent devant les rayons."

msgid "At least 3x4, with a till and a shelf. Shop staff serve at the till."
msgstr "Au moins 3x4, avec une caisse et un rayon. Les vendeurs servent à la caisse."

msgid "The duty free shop's till."
msgstr "La caisse du duty-free."

msgid "Place it inside a duty free shop. A server stands behind it."
msgstr "Placez-la dans une boutique duty-free. Un vendeur se tient derrière."

msgid "Wholly inside the shop. Shop staff hired in Staff, and the spot in front clear."
msgstr "Entièrement dans la boutique. Vendeurs embauchés dans Personnel, et la case devant libre."

msgid "A duty free shelf. Each one gives two browse spots."
msgstr "Un rayon duty-free. Chacun offre deux emplacements de visite."

msgid "Passengers browse from the cells in front of it."
msgstr "Les passagers regardent depuis les cases devant."

msgid "Inside a duty free shop. Keep the cells in front clear."
msgstr "Dans une boutique duty-free. Gardez les cases devant libres."

msgid "Marks floor as a fashion store. Passengers browse and spend more than in a kiosk."
msgstr "Marque le sol comme boutique de mode. Les passagers flânent et dépensent plus qu'en kiosque."

msgid "Drag a rectangle, then add a till and clothes rails. Passengers browse at the rails."
msgstr "Glissez un rectangle, puis ajoutez une caisse et des portants. Les passagers flânent devant les portants."

msgid "At least 3x4, with a till and a clothes rail. Shop staff serve at the till."
msgstr "Au moins 3x4, avec une caisse et un portant. Les vendeurs servent à la caisse."

msgid "The fashion store's till."
msgstr "La caisse de la boutique de mode."

msgid "Place it inside a fashion store. A server stands behind it."
msgstr "Placez-la dans une boutique de mode. Un vendeur se tient derrière."

msgid "Wholly inside the store. Shop staff hired in Staff, and the spot in front clear."
msgstr "Entièrement dans la boutique. Vendeurs embauchés dans Personnel, et la case devant libre."

msgid "A clothes rail. Each one gives two browse spots."
msgstr "Un portant à vêtements. Chacun offre deux emplacements de visite."

msgid "Inside a fashion store. Keep the cells in front clear."
msgstr "Dans une boutique de mode. Gardez les cases devant libres."

msgid "Marks floor as a currency exchange. Passengers change money and pay a small fee."
msgstr "Marque le sol comme bureau de change. Les passagers changent leur argent et paient une commission."

msgid "Drag a rectangle, then add a counter. A server works it."
msgstr "Glissez un rectangle, puis ajoutez un comptoir. Un vendeur l'opère."

msgid "At least 2x3, with a counter and shop staff. A visit does not cure boredom."
msgstr "Au moins 2x3, avec un comptoir et un vendeur. La visite ne réduit pas l'ennui."

msgid "Marks floor as an ATM room. Passengers take out cash and pay a small fee."
msgstr "Marque le sol comme espace DAB. Les passagers retirent des espèces et paient une commission."

msgid "Drag a rectangle, then add an ATM. It is self-service."
msgstr "Glissez un rectangle, puis ajoutez un DAB. C'est en libre-service."

msgid "At least 1x2, with an ATM. No staff. A visit does not cure boredom."
msgstr "Au moins 1x2, avec un DAB. Sans personnel. La visite ne réduit pas l'ennui."

msgid "Marks floor as a bar. Guests stay longer than in a cafe, spend more, and gain most mood."
msgstr "Marque le sol comme bar. Les clients restent plus longtemps qu'au café, dépensent plus et gagnent plus d'humeur."

msgid "Guests order at a bar counter and sit on its stools."
msgstr "Les clients commandent au comptoir de bar et s'assoient sur ses tabourets."

msgid "At least 3x4, with a bar counter. Shop staff serve at the counter."
msgstr "Au moins 3x4, avec un comptoir de bar. Les vendeurs servent au comptoir."

msgid "Marks floor as a sit-down restaurant. Guests stay the longest and spend the most."
msgstr "Marque le sol comme restaurant avec service à table. Les clients restent le plus longtemps et dépensent le plus."

msgid "Guests order at a cafe counter and sit at a dining table or a booth."
msgstr "Les clients commandent au comptoir et s'assoient à une table à dîner ou une banquette."

msgid "At least 4x4, with a counter and a table or booth. Shop staff serve at the counter."
msgstr "Au moins 4x4, avec un comptoir et une table ou banquette. Les vendeurs servent au comptoir."

msgid "Marks floor as a grab-and-go stall. Guests buy, pay and walk on, with no seat."
msgstr "Marque le sol comme comptoir à emporter. Les clients achètent, paient et repartent sans siège."

msgid "It needs only a grab-and-go stall. A server hands over the order."
msgstr "Ne nécessite qu'un comptoir à emporter. Un vendeur remet la commande."

msgid "At least 3x3, with a counter. Shop staff serve. It earns the least of the food rooms."
msgstr "Au moins 3x3, avec un comptoir. Servi par les vendeurs. Rapporte le moins des salles de restauration."

msgid "Marks floor as a play area. Passengers stay and play for free and their mood rises."
msgstr "Marque le sol comme aire de jeux. Les passagers jouent gratuitement et leur humeur monte."

msgid "Drag a rectangle, then add a slide and play blocks. It is self-service."
msgstr "Glissez un rectangle, puis ajoutez un toboggan et des blocs de jeu. C'est en libre-service."

msgid "At least 3x4, with a slide and play blocks. No staff."
msgstr "Au moins 3x4, avec un toboggan et des blocs de jeu. Sans personnel."

msgid "Marks floor as a lounge. Passengers rest on the sofas for free and their mood rises."
msgstr "Marque le sol comme salon. Les passagers se reposent sur les canapés gratuitement et leur humeur monte."

msgid "Drag a rectangle, then add a sofa. It is self-service."
msgstr "Glissez un rectangle, puis ajoutez un canapé. C'est en libre-service."

msgid "At least 2x3, with a sofa. No staff."
msgstr "Au moins 2x3, avec un canapé. Sans personnel."

msgid "Marks floor as a shower room. Passengers pay to wash during a long wait and gain mood."
msgstr "Marque le sol comme salle de douches. Les passagers paient pour se laver lors d'une longue attente et gagnent de l'humeur."

msgid "Drag a rectangle, then add a shower cubicle. It is self-service."
msgstr "Glissez un rectangle, puis ajoutez une cabine de douche. C'est en libre-service."

msgid "At least 2x2, with a shower cubicle. No staff. Each stay pays you a fee."
msgstr "Au moins 2x2, avec une cabine de douche. Sans personnel. Chaque passage vous rapporte des frais."

msgid "Marks floor as a nap pod room. Passengers pay to rest during a long wait and gain mood."
msgstr "Marque le sol comme salle de capsules de sieste. Les passagers paient pour se reposer lors d'une longue attente et gagnent de l'humeur."

msgid "Drag a rectangle, then add a nap pod. It is self-service."
msgstr "Glissez un rectangle, puis ajoutez une capsule de sieste. C'est en libre-service."

msgid "At least 2x2, with a nap pod. No staff. Each stay pays you a fee."
msgstr "Au moins 2x2, avec une capsule de sieste. Sans personnel. Chaque passage vous rapporte des frais."

msgid "A shelf unit. Each stand gives the kiosk two browse spots."
msgstr "Un présentoir. Chacun offre au kiosque deux emplacements de visite."

msgid "Inside a kiosk. Keep the cells in front clear."
msgstr "Dans un kiosque. Gardez les cases devant libres."

msgid "A baggage belt. It carries checked bags from a check-in desk to a bag room."
msgstr "Un tapis à bagages. Il transporte les bagages enregistrés d'un comptoir d'enreg. vers une salle bagages."

msgid "Drag a line. The belt shapes itself at turns and joins. Belts cannot cross."
msgstr "Glissez une ligne. Le tapis s'adapte aux virages et jonctions. Les tapis ne peuvent pas se croiser."

msgid "Start at a check-in desk's back and end in a bag room. A wall in the way blocks it."
msgstr "Partez de l'arrière d'un comptoir d'enreg. et terminez dans une salle bagages. Un mur bloque le tracé."

msgid "Where checked bags end up. They are loaded onto the plane from here."
msgstr "Là où arrivent les bagages enregistrés. Ils sont chargés dans l'avion depuis ici."

msgid "Drag a rectangle, then run a belt into it. The belt's end piece goes inside."
msgstr "Glissez un rectangle, puis menez-y un tapis. L'embout de fin de tapis va à l'intérieur."

msgid "At least 2x2, with a belt end. A bag that arrives after the cutoff misses the plane."
msgstr "Au moins 2x2, avec une fin de tapis. Un bagage arrivé après la limite rate l'avion."

msgid "A baggage cart on wheels."
msgstr "Un chariot à bagages sur roues."

msgid "Place one in a bag room so a hired Ramp Agent drives checked bags out to the parked plane."
msgstr "Placez-en un dans une salle bagages pour qu'un agent de piste conduise les bagages vers l'avion garé."

msgid "Needs a Ramp Agent hired in Staff. Takes 1x2 tiles; no upkeep."
msgstr "Nécessite un agent de piste embauché dans Personnel. Occupe 1x2 cases ; aucun entretien."

msgid "A curb bay on the road outside. Cars and taxis stop here and drop passengers off."
msgstr "Une baie dépose-minute sur la route extérieure. Voitures et taxis s'y arrêtent pour déposer des passagers."

msgid "Click one of the marked spots by the road. Each bay has two berths."
msgstr "Cliquez sur l'un des emplacements marqués au bord de la route. Chaque baie a deux places."

msgid "Marked spots only. The nearer an entrance, the shorter the walk."
msgstr "Emplacements marqués uniquement. Plus c'est près d'une entrée, plus le trajet est court."

msgid "A car park with 12 spaces. A car pays a fee when it parks."
msgstr "Un parking de 12 places. Chaque voiture paie des frais en se garant."

msgid "Click a marked spot. Passengers walk from the car park to an entrance."
msgstr "Cliquez sur un emplacement marqué. Les passagers marchent du parking jusqu'à une entrée."

msgid "Marked spots only. Close it to let it drain before you remove it."
msgstr "Emplacements marqués uniquement. Fermez-le pour le laisser se vider avant de le supprimer."

msgid "A big car park with 31 spaces. A car pays a higher fee than a surface lot when it parks."
msgstr "Un grand parking de 31 places. Chaque voiture paie un tarif plus élevé qu'en parking de surface."

msgid "Opens or closes a car park."
msgstr "Ouvre ou ferme un parking."

msgid "Click a built car park. A closed one takes no new cars and empties out."
msgstr "Cliquez sur un parking construit. Fermé, il n'accepte plus de voitures et se vide."

msgid "A car park can only be removed once no cars are in it."
msgstr "Un parking ne peut être supprimé qu'une fois vide de toute voiture."

msgid "Buys a plot of land. You can only build on land you own."
msgstr "Achète une parcelle de terrain. Vous ne pouvez bâtir que sur vos terres."

msgid "Click a highlighted plot. Its price shows on it and rises with each plot you buy."
msgstr "Cliquez sur une parcelle surlignée. Son prix s'affiche dessus et augmente à chaque achat."

msgid "A plot next to land you already own."
msgstr "Une parcelle voisine d'un terrain que vous possédez déjà."

msgid "The tray table of a security lane, where passengers unpack their bags."
msgstr "La table de bacs d'un couloir de sécurité, où les passagers posent leurs affaires."

msgid "It stands beside the arch, on the side the lane's parts go."
msgstr "Elle se place à côté du portique, du côté des éléments du couloir."

msgid "Part of a whole lane: arch, tray table, X-ray belt and pickup table."
msgstr "Élément d'un couloir complet : portique, table de bacs, tunnel X et table de retrait."

msgid "The X-ray belt of a security lane. Bags ride through it."
msgstr "Le tunnel à rayons X d'un couloir de sécurité. Les sacs passent dedans."

msgid "It stands beside the arch. A lane officer works at it."
msgstr "Il se place à côté du portique. Un agent de sécurité y travaille."

msgid "Part of a whole lane. Needs a security officer hired in Staff."
msgstr "Élément d'un couloir complet. Nécessite un agent de sécurité embauché dans Personnel."

msgid "The arch of a security lane. Passengers walk through it."
msgstr "Le portique d'un couloir de sécurité. Les passagers le traversent."

msgid "Place the arch first and the other parts around it. Its front faces the queue."
msgstr "Placez d'abord le portique puis les autres éléments autour. L'avant fait face à la file."

msgid "Part of a whole lane. Keep the spot in front and the walls around the lane clear."
msgstr "Élément d'un couloir complet. Gardez la case devant et les murs autour du couloir libres."

msgid "The pickup table of a security lane, where passengers collect their bags."
msgstr "La table de retrait d'un couloir de sécurité, où les passagers récupèrent leurs sacs."

msgid "It stands past the arch, where cleared passengers leave the lane."
msgstr "Elle se place après le portique, là où les passagers contrôlés quittent le couloir."

msgid "A bush. It calms passengers close to it, a little."
msgstr "Un buisson. Il calme un peu les passagers tout proches."

msgid "Passengers within a cell or so get calm, which becomes mood. Walls block it."
msgstr "Les passagers à environ une case s'apaisent, ce qui améliore l'humeur. Les murs bloquent l'effet."

msgid "No upkeep. It earns nothing."
msgstr "Aucun entretien. Ne rapporte rien."

msgid "A planter. It calms passengers near it, a little."
msgstr "Une jardinière. Elle calme un peu les passagers proches."

msgid "Passengers within a couple of cells get calm, which becomes mood. Walls block it."
msgstr "Les passagers à quelques cases s'apaisent, ce qui améliore l'humeur. Les murs bloquent l'effet."

msgid "A large plant pot. It calms passengers near it, a little."
msgstr "Un grand pot de plante. Il calme un peu les passagers proches."

msgid "An indoor tree. It calms the passengers around it."
msgstr "Un arbre d'intérieur. Il calme les passagers autour de lui."

msgid "Passengers within a few cells get calm, which becomes mood. Walls block it."
msgstr "Les passagers dans un rayon de quelques cases s'apaisent, ce qui améliore l'humeur. Les murs bloquent l'effet."

msgid "A bench. It seats two waiting passengers and calms passengers nearby."
msgstr "Un banc. Offre deux places assises aux passagers et calme ceux qui sont proches."

msgid "Gate passengers sit on it. Calm becomes mood, and a wall between them blocks it."
msgstr "Les passagers en porte s'y assoient. Le calme devient humeur, mais un mur entre eux le bloque."

msgid "A bench built around a tree. It calms the passengers near it."
msgstr "Un banc autour d'un arbre. Il calme les passagers proches."

msgid "A fountain. It calms the passengers around it the most, with a long reach."
msgstr "Une fontaine. C'est ce qui calme le plus les passagers autour, avec une longue portée."

msgid "A statue. It calms the passengers around it, with a long reach."
msgstr "Une statue. Elle calme les passagers autour avec une longue portée."

msgid "A retractable-belt stanchion post. Passengers cannot walk through it."
msgstr "Un poteau à sangle rétractable. Les passagers ne peuvent pas le traverser."

msgid "Use stanchions and queue belts to steer a queue. They give a little calm nearby."
msgstr "Utilisez poteaux et sangles pour guider une file. Ils apportent un peu de calme à proximité."

msgid "A queue belt between two stanchions, three cells long. Passengers cannot walk through it."
msgstr "Une sangle de file entre deux poteaux, longue de trois cases. Les passagers ne peuvent pas la traverser."

msgid "A bin. Passengers drop litter in it instead of leaving it on the floor."
msgstr "Une poubelle. Les passagers y jettent leurs déchets au lieu de les laisser au sol."

msgid "A bin takes litter from visits near it, and a cleaner empties it when it is full."
msgstr "Une poubelle capte les déchets des passages proches, et un agent d'entretien la vide une fois pleine."

msgid "A cleaner hired in Staff. It gives no calm, and a bin in view takes a little back."
msgstr "Un agent d'entretien embauché dans Personnel. N'apaise pas, et une poubelle visible réduit un peu le calme."

msgid "A bar counter, where guests order drinks."
msgstr "Un comptoir de bar, où les clients commandent des boissons."

msgid "Place it inside a bar. A server stands behind it and guests order from the cell in front."
msgstr "Placez-le dans un bar. Un serveur se tient derrière et les clients commandent depuis la case devant."

msgid "Wholly inside the bar. Shop staff hired in Staff, and the spot in front clear."
msgstr "Entièrement dans le bar. Vendeurs embauchés dans Personnel, et la case devant libre."

msgid "A grab-and-go stall, where guests buy and walk on."
msgstr "Un stand à emporter, où les clients achètent et repartent."

msgid "Place it inside a grab-and-go room. A server hands over the order."
msgstr "Placez-le dans une salle à emporter. Un serveur remet la commande."

msgid "A restaurant table with four seats."
msgstr "Une table de restaurant à quatre places."

msgid "Place it inside a restaurant. A guest walks from the counter to a free seat."
msgstr "Placez-la dans un restaurant. Le client va du comptoir vers un siège libre."

msgid "Wholly inside the restaurant, with the cell behind each chair clear."
msgstr "Entièrement dans le restaurant, avec la case derrière chaque chaise libre."

msgid "A restaurant booth with four seats."
msgstr "Une banquette de restaurant à quatre places."

msgid "Wholly inside the restaurant, with the cell behind each seat clear."
msgstr "Entièrement dans le restaurant, avec la case derrière chaque place libre."

msgid "A staffed desk that helps lost passengers."
msgstr "Un bureau avec personnel qui aide les passagers perdus."

msgid "A stuck passenger nearby walks over, is helped, gains mood and plans its route again."
msgstr "Un passager bloqué à proximité vient, se fait aider, gagne de l'humeur et recalcule son trajet."

msgid "Shop staff hired in Staff, or it does nothing. Works on open floor or in a room."
msgstr "Vendeurs embauchés dans Personnel, sinon il ne fait rien. Marche en salle ouverte ou fermée."

msgid "An information display."
msgstr "Un panneau d'information."

msgid "Scenery for now: nothing in the game reacts to it."
msgstr "Décor pour l'instant : rien dans le jeu n'interagit avec."

msgid "Costs upkeep every day."
msgstr "Coûte de l'entretien chaque jour."

msgid "The currency exchange counter."
msgstr "Le comptoir de bureau de change."

msgid "Place it inside an exchange room. A server stands behind it and changes money."
msgstr "Placez-le dans un bureau de change. Un serveur se tient derrière et change l'argent."

msgid "A cash machine. One passenger uses it at a time and pays a small fee."
msgstr "Un distributeur de billets. Un passager l'utilise à la fois et paie une commission."

msgid "Place it inside an ATM room. The passenger uses it from the cell in front."
msgstr "Placez-le dans un espace DAB. Le passager l'utilise depuis la case devant."

msgid "Keep the spot in front clear. No staff and no upkeep."
msgstr "Gardez la case devant libre. Sans personnel ni entretien."

msgid "The pharmacy counter, with a till."
msgstr "Le comptoir de la pharmacie, avec une caisse."

msgid "Place it inside a pharmacy. A server stands behind it."
msgstr "Placez-le dans une pharmacie. Un serveur se tient derrière."

msgid "Wholly inside the pharmacy. Shop staff hired in Staff, and the spot in front clear."
msgstr "Entièrement dans la pharmacie. Vendeurs embauchés dans Personnel, et la case devant libre."

msgid "A pharmacy shelf. Each one gives one browse spot."
msgstr "Un rayon de pharmacie. Chacun offre un emplacement de visite."

msgid "Passengers browse from the cell in front of it."
msgstr "Les passagers regardent depuis la case devant."

msgid "Inside a pharmacy. Keep the cells in front clear."
msgstr "Dans une pharmacie. Gardez les cases devant libres."

msgid "A shower cubicle. One passenger uses it at a time and pays a fee."
msgstr "Une cabine de douche. Un passager l'utilise à la fois et paie des frais."

msgid "Place it inside a shower room. The passenger steps in from the cell in front."
msgstr "Placez-la dans une salle de douches. Le passager entre depuis la case devant."

msgid "Keep the spot in front clear. No upkeep."
msgstr "Gardez la case devant libre. Aucun entretien."

msgid "A nap pod. One passenger uses it at a time and pays a fee."
msgstr "Une capsule de sieste. Un passager l'utilise à la fois et paie des frais."

msgid "Place it inside a nap pod room. The passenger sits and leans back."
msgstr "Placez-la dans une salle de capsules de sieste. Le passager s'assoit et s'allonge."

msgid "A two-seat sofa. Lounge guests rest on it."
msgstr "Un canapé deux places. Les visiteurs du salon s'y reposent."

msgid "Place it inside a lounge. Each sofa gives two seats."
msgstr "Placez-le dans un salon. Chaque canapé offre deux places."

msgid "No upkeep. The lounge is free to use."
msgstr "Aucun entretien. L'accès au salon est gratuit."

msgid "A single armchair."
msgstr "Un fauteuil individuel."

msgid "A passenger can sit on it, but a lounge needs a sofa. The armchair does not count."
msgstr "Un passager peut s'y asseoir, mais un salon exige un canapé. Le fauteuil ne compte pas."

msgid "A work desk."
msgstr "Un bureau de travail."

msgid "Play blocks for children."
msgstr "Blocs de jeu pour enfants."

msgid "Place them inside a play area. A play area needs them and a slide."
msgstr "Placez-les dans une aire de jeux. Une aire de jeux exige les blocs et un toboggan."

msgid "No upkeep. The play area is free to use."
msgstr "Aucun entretien. L'aire de jeux est gratuite."

msgid "A play slide. Children use it from the front."
msgstr "Un toboggan de jeu. Les enfants l'utilisent par devant."

msgid "Place it inside a play area. Each slide gives two play spots."
msgstr "Placez-le dans une aire de jeux. Chaque toboggan offre deux places de jeu."

msgid "A prize car on a podium. Passengers near it spend a bit more in shops and food rooms."
msgstr "Une voiture d'exposition sur podium. Les passagers proches dépensent un peu plus en boutique et restauration."

msgid "Waiting passengers who see it lose boredom. A second podium does not stack."
msgstr "Les passagers en attente qui la voient s'ennuient moins. Un deuxième podium ne se cumule pas."

msgid "Costs upkeep every day. A plain wall blocks the view."
msgstr "Coûte de l'entretien chaque jour. Un mur plein bloque la vue."

