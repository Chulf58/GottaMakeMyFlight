msgstr ""
"Project-Id-Version: Gotta Make My Flight\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "No flights yet"
msgstr "Sin vuelos aún"

msgid "No flights yet: the rating starts when passengers make or miss a flight."
msgstr "Sin vuelos aún: la valoración empieza cuando los pasajeros toman o pierden un vuelo."

msgid "Made it: {share}% ({made} of {count} passenger)"
msgid_plural "Made it: {share}% ({made} of {count} passengers)"
msgstr[0] "Embarcados: {share}% ({made} de {count} pasajero)"
msgstr[1] "Embarcados: {share}% ({made} de {count} pasajeros)"

msgid "Airport rating: {stars} of {max}"
msgstr "Valoración del aeropuerto: {stars} de {max}"

msgid "Mood: {mood} of {max}"
msgstr "Ánimo: {mood} de {max}"

msgid "Incident adjustment: {amount} stars"
msgstr "Ajuste por incidente: {amount} estrellas"

msgid "Days counted: {days} of {window}"
msgstr "Días contados: {days} de {window}"

msgid "Floor tile. Passengers can only walk and stand on floor."
msgstr "Baldosa de suelo. Los pasajeros solo pueden caminar y estar sobre el suelo."

msgid "Drag a rectangle to lay many tiles at once. Everything else is built on floor."
msgstr "Arrastra un rectángulo para colocar varias baldosas a la vez. Todo lo demás se construye sobre el suelo."

msgid "Land you own. Removing a tile refunds half."
msgstr "Terreno de tu propiedad. Quitar una baldosa reembolsa la mitad."

msgid "A wall along a tile edge. Passengers cannot cross it and it blocks the view."
msgstr "Un muro en el borde de una baldosa. Los pasajeros no pueden cruzarlo y bloquea la vista."

msgid "Drag along a line to build a row. Walls close in the terminal and its rooms."
msgstr "Arrastra en línea para construir una fila. Los muros cierran la terminal y sus salas."

msgid "One wall per tile edge. Removing it refunds half."
msgstr "Un muro por borde de baldosa. Quitarlo reembolsa la mitad."

msgid "A glass wall. Passengers cannot cross it, but it lets the view through."
msgstr "Un muro de cristal. Los pasajeros no pueden cruzarlo, pero deja ver a través."

msgid "Drag along a line like a wall. Screens and decor can be seen through glass."
msgstr "Arrastra en línea como un muro. Las pantallas y la decoración se ven a través del cristal."

msgid "Costs more than a plain wall. One per tile edge."
msgstr "Cuesta más que un muro normal. Uno por borde de baldosa."

msgid "A door in a wall. Passengers walk through it."
msgstr "Una puerta en un muro. Los pasajeros la atraviesan."

msgid "Click a wall edge to put a door in the wall."
msgstr "Haz clic en un muro para poner una puerta."

msgid "A plain wall on each side of it."
msgstr "Un muro normal a cada lado."

msgid "The way into the terminal. Passengers come in here from the road and car parks."
msgstr "La entrada a la terminal. Los pasajeros llegan por aquí desde la carretera y los aparcamientos."

msgid "Place it on the outer edge of the terminal, facing in."
msgstr "Colócala en el borde exterior de la terminal, mirando hacia dentro."

msgid "The outside edge with no floor behind it. Keep the spot in front clear."
msgstr "El borde exterior sin suelo detrás. Deja libre la casilla de delante."

msgid "The way out to the planes. Passengers leave the terminal here to board."
msgstr "La salida hacia los aviones. Los pasajeros salen de la terminal por aquí para embarcar."

msgid "Place it on the outer edge. A gate desk links to an exit facing west, north or east."
msgstr "Colócala en el borde exterior. Un mostrador de puerta se enlaza con una salida al oeste, norte o este."

msgid "Where passengers check in and hand over a bag."
msgstr "Donde los pasajeros facturan y entregan su equipaje."

msgid "A check-in agent works behind it. A belt from its back edge takes bags to a bag room."
msgstr "Un agente de check-in trabaja detrás. Una cinta desde su parte trasera lleva el equipaje a la sala de equipaje."

msgid "An agent hired in Staff, or it stays closed. Keep the spot behind and in front clear."
msgstr "Un agente contratado en Personal, o seguirá cerrado. Deja libre delante y detrás."

msgid "A basic security scanner. Passengers walk through it to be screened."
msgstr "Un escáner de seguridad básico. Los pasajeros pasan por él para el control."

msgid "A security officer works beside it. A full lane is faster but costs more."
msgstr "Un agente de seguridad trabaja al lado. Un carril completo es más rápido pero cuesta más."

msgid "An officer hired in Staff, or it stays closed. Keep its staff spot and way in clear."
msgstr "Un agente contratado en Personal, o seguirá cerrado. Deja libre su puesto y la entrada."

msgid "A row of seats. Passengers wait here for their flight and their mood recovers."
msgstr "Una fila de asientos. Los pasajeros esperan aquí su vuelo y recuperan el ánimo."

msgid "Place it near the gate and turn it. Waiting passengers sit on it."
msgstr "Colócala cerca de la puerta y gírala. Los pasajeros en espera se sientan en ella."

msgid "No staff and no upkeep. Add enough seats for the passengers waiting."
msgstr "Sin personal ni mantenimiento. Añade suficientes asientos para los pasajeros que esperan."

msgid "Makes a gate. It links to the nearest free exit facing the planes; the plane parks out from it."
msgstr "Crea una puerta. Se enlaza con la salida libre más cercana hacia los aviones; el avión aparca allí."

msgid "Each flight is given a gate. A gate takes the next free letter, starting at A."
msgstr "Cada vuelo recibe una puerta. Cada puerta toma la siguiente letra libre, empezando por A."

msgid "Within 4 cells of a free exit facing the planes, with room for the plane. No staff needed."
msgstr "A 4 casillas o menos de una salida libre hacia los aviones, con espacio para el avión. Sin personal."

msgid "A floor screen that entertains passengers waiting in front of it."
msgstr "Una pantalla de suelo que entretiene a los pasajeros que esperan delante."

msgid "It covers a fan of floor up to 5 rows ahead. A plain wall blocks it, glass does not."
msgstr "Cubre un abanico de suelo hasta 5 filas por delante. Un muro normal lo bloquea, el cristal no."

msgid "Costs upkeep every day, inside a room or not."
msgstr "Cuesta mantenimiento cada día, dentro de una sala o no."

msgid "Marks floor as a cafe. Hungry passengers eat and drink here and their mood rises."
msgstr "Marca el suelo como cafetería. Los pasajeros hambrientos comen y beben aquí y sube su ánimo."

msgid "Drag a rectangle, then add a counter and a table. Guests order, then sit at the table."
msgstr "Arrastra un rectángulo y añade un mostrador y una mesa. Los clientes piden y luego se sientan."

msgid "At least 3x3, with a counter and a table. Needs shop staff, or the counter stays closed."
msgstr "Al menos 3x3, con mostrador y mesa. Necesita personal de tienda o el mostrador seguirá cerrado."

msgid "The cafe counter, where guests order."
msgstr "El mostrador de la cafetería, donde piden los clientes."

msgid "Place it inside a cafe or restaurant. A server stands there."
msgstr "Colócalo dentro de una cafetería o restaurante. Un empleado atiende allí."

msgid "Wholly inside the room. Shop staff hired in Staff, and the spot in front clear."
msgstr "Totalmente dentro de la sala. Personal de tienda contratado en Personal y el espacio frontal libre."

msgid "A table with a seat at each end. Cafe guests sit here to eat."
msgstr "Una mesa con un asiento a cada lado. Los clientes de la cafetería se sientan a comer."

msgid "It seats two. A guest walks from the counter to a free seat."
msgstr "Tiene dos plazas. El cliente camina del mostrador a un asiento libre."

msgid "Inside a cafe. A bar uses bar counters, and a restaurant uses dining tables or booths."
msgstr "Dentro de una cafetería. Un bar usa barras de bar, y un restaurante usa mesas de comedor o reservados."

msgid "Marks floor as a toilet. Passengers who need one queue and use a stall."
msgstr "Marca el suelo como aseos. Los pasajeros que lo necesitan hacen cola y usan un retrete."

msgid "Drag a rectangle, then add a stall and a sink inside."
msgstr "Arrastra un rectángulo y añade un retrete y un lavabo dentro."

msgid "At least 2x3, with a stall and a sink. Each stall costs upkeep every day when ready."
msgstr "Al menos 2x3, con un retrete y un lavabo. Cada retrete cuesta mantenimiento al día cuando está listo."

msgid "One toilet stall. One passenger uses it at a time."
msgstr "Un retrete. Lo usa un pasajero a la vez."

msgid "Place it inside a toilet room. A passenger walks in from the cell in front."
msgstr "Colócalo dentro de unos aseos. El pasajero entra desde la casilla de delante."

msgid "Keep the spot in front clear. Costs upkeep every day once its room is ready."
msgstr "Deja libre la casilla de delante. Cuesta mantenimiento cada día cuando la sala está lista."

msgid "A sink. A toilet room is not ready without one."
msgstr "Un lavabo. Los aseos no están listos sin uno."

msgid "Place it inside a toilet room."
msgstr "Colócalo dentro de unos aseos."

msgid "Keep the spot in front clear. No upkeep of its own."
msgstr "Deja libre la casilla de delante. Sin mantenimiento propio."

msgid "Marks floor as a kiosk, a small shop. Bored passengers browse here and pay."
msgstr "Marca el suelo como quiosco, una tienda pequeña. Los pasajeros aburridos curiosean aquí y pagan."

msgid "Drag a rectangle, then add a counter and display stands. Guests browse at the stands."
msgstr "Arrastra un rectángulo y añade un mostrador y expositores. Los clientes curiosean en los expositores."

msgid "At least 3x3, with a counter and a display stand. Shop staff serve at the counter."
msgstr "Al menos 3x3, con un mostrador y un expositor. El personal de tienda atiende en el mostrador."

msgid "The kiosk's counter, with a till."
msgstr "El mostrador del quiosco, con caja registradora."

msgid "Place it inside a kiosk. A server stands behind it."
msgstr "Colócalo dentro de un quiosco. Un empleado atiende detrás."

msgid "Wholly inside the kiosk. Shop staff hired in Staff, and the spot in front clear."
msgstr "Totalmente dentro del quiosco. Personal de tienda contratado en Personal y la casilla frontal libre."

msgid "Marks floor as a pharmacy. Passengers browse and buy here."
msgstr "Marca el suelo como farmacia. Los pasajeros curiosean y compran aquí."

msgid "Drag a rectangle, then add a counter and a shelf. Passengers browse at the shelf."
msgstr "Arrastra un rectángulo y añade un mostrador y una estantería. Los pasajeros curiosean en la estantería."

msgid "At least 3x3, with a counter and a shelf. Shop staff serve at the counter."
msgstr "Al menos 3x3, con un mostrador y una estantería. El personal de tienda atiende en el mostrador."

msgid "Marks floor as a duty free shop. Passengers browse and spend more than in a kiosk."
msgstr "Marca el suelo como tienda duty-free. Los pasajeros curiosean y gastan más que en un quiosco."

msgid "Drag a rectangle, then add a till and shelves. Passengers browse at the shelves."
msgstr "Arrastra un rectángulo y añade una caja y estanterías. Los pasajeros curiosean en las estanterías."

msgid "At least 3x4, with a till and a shelf. Shop staff serve at the till."
msgstr "Al menos 3x4, con una caja y una estantería. El personal de tienda atiende en la caja."

msgid "The duty free shop's till."
msgstr "La caja de la tienda duty-free."

msgid "Place it inside a duty free shop. A server stands behind it."
msgstr "Colócala dentro de una tienda duty-free. Un empleado atiende detrás."

msgid "Wholly inside the shop. Shop staff hired in Staff, and the spot in front clear."
msgstr "Totalmente dentro de la tienda. Personal de tienda contratado en Personal y la casilla frontal libre."

msgid "A duty free shelf. Each one gives two browse spots."
msgstr "Una estantería duty-free. Cada una ofrece dos puestos para curiosear."

msgid "Passengers browse from the cells in front of it."
msgstr "Los pasajeros curiosean desde las casillas de delante."

msgid "Inside a duty free shop. Keep the cells in front clear."
msgstr "Dentro de una tienda duty-free. Deja libres las casillas de delante."

msgid "Marks floor as a fashion store. Passengers browse and spend more than in a kiosk."
msgstr "Marca el suelo como tienda de moda. Los pasajeros curiosean y gastan más que en un quiosco."

msgid "Drag a rectangle, then add a till and clothes rails. Passengers browse at the rails."
msgstr "Arrastra un rectángulo y añade una caja y percheros. Los pasajeros curiosean en los percheros."

msgid "At least 3x4, with a till and a clothes rail. Shop staff serve at the till."
msgstr "Al menos 3x4, con una caja y un perchero. El personal de tienda atiende en la caja."

msgid "The fashion store's till."
msgstr "La caja de la tienda de moda."

msgid "Place it inside a fashion store. A server stands behind it."
msgstr "Colócala dentro de una tienda de moda. Un empleado atiende detrás."

msgid "Wholly inside the store. Shop staff hired in Staff, and the spot in front clear."
msgstr "Totalmente dentro de la tienda. Personal de tienda contratado en Personal y la casilla frontal libre."

msgid "A clothes rail. Each one gives two browse spots."
msgstr "Un perchero de ropa. Cada uno ofrece dos puestos para curiosear."

msgid "Inside a fashion store. Keep the cells in front clear."
msgstr "Dentro de una tienda de moda. Deja libres las casillas de delante."

msgid "Marks floor as a currency exchange. Passengers change money and pay a small fee."
msgstr "Marca el suelo como cambio de divisas. Los pasajeros cambian dinero y pagan una pequeña comisión."

msgid "Drag a rectangle, then add a counter. A server works it."
msgstr "Arrastra un rectángulo y añade un mostrador. Un empleado lo atiende."

msgid "At least 2x3, with a counter and shop staff. A visit does not cure boredom."
msgstr "Al menos 2x3, con un mostrador y personal de tienda. Una visita no quita el aburrimiento."

msgid "Marks floor as an ATM room. Passengers take out cash and pay a small fee."
msgstr "Marca el suelo como sala de cajero. Los pasajeros sacan efectivo y pagan una pequeña comisión."

msgid "Drag a rectangle, then add an ATM. It is self-service."
msgstr "Arrastra un rectángulo y añade un cajero automático. Es autoservicio."

msgid "At least 1x2, with an ATM. No staff. A visit does not cure boredom."
msgstr "Al menos 1x2, con un cajero automático. Sin personal. Una visita no quita el aburrimiento."

msgid "Marks floor as a bar. Guests stay longer than in a cafe, spend more, and gain most mood."
msgstr "Marca el suelo como bar. Los clientes se quedan más que en la cafetería, gastan más y ganan más ánimo."

msgid "Guests order at a bar counter and sit on its stools."
msgstr "Los clientes piden en la barra de bar y se sientan en sus taburetes."

msgid "At least 3x4, with a bar counter. Shop staff serve at the counter."
msgstr "Al menos 3x4, con una barra de bar. El personal de tienda atiende en la barra."

msgid "Marks floor as a sit-down restaurant. Guests stay the longest and spend the most."
msgstr "Marca el suelo como restaurante. Los clientes se quedan más tiempo y gastan más que en ningún otro sitio."

msgid "Guests order at a cafe counter and sit at a dining table or a booth."
msgstr "Los clientes piden en un mostrador y se sientan en una mesa de comedor o un reservado."

msgid "At least 4x4, with a counter and a table or booth. Shop staff serve at the counter."
msgstr "Al menos 4x4, con un mostrador y una mesa o reservado. El personal de tienda atiende en el mostrador."

msgid "Marks floor as a grab-and-go stall. Guests buy, pay and walk on, with no seat."
msgstr "Marca el suelo como puesto para llevar. Los clientes compran, pagan y siguen caminando, sin asientos."

msgid "It needs only a grab-and-go stall. A server hands over the order."
msgstr "Solo necesita un puesto para llevar. Un empleado entrega el pedido."

msgid "At least 3x3, with a counter. Shop staff serve. It earns the least of the food rooms."
msgstr "Al menos 3x3, con un mostrador. Atendido por personal de tienda. Es el que menos gana de comida."

msgid "Marks floor as a play area. Passengers stay and play for free and their mood rises."
msgstr "Marca el suelo como zona de juegos. Los pasajeros se quedan a jugar gratis y su ánimo sube."

msgid "Drag a rectangle, then add a slide and play blocks. It is self-service."
msgstr "Arrastra un rectángulo y añade un tobogán y bloques de juego. Es autoservicio."

msgid "At least 3x4, with a slide and play blocks. No staff."
msgstr "Al menos 3x4, con un tobogán y bloques de juego. Sin personal."

msgid "Marks floor as a lounge. Passengers rest on the sofas for free and their mood rises."
msgstr "Marca el suelo como sala VIP. Los pasajeros descansan en los sofás gratis y su ánimo sube."

msgid "Drag a rectangle, then add a sofa. It is self-service."
msgstr "Arrastra un rectángulo y añade un sofá. Es autoservicio."

msgid "At least 2x3, with a sofa. No staff."
msgstr "Al menos 2x3, con un sofá. Sin personal."

msgid "Marks floor as a shower room. Passengers pay to wash during a long wait and gain mood."
msgstr "Marca el suelo como sala de duchas. Los pasajeros pagan por ducharse en esperas largas y ganan ánimo."

msgid "Drag a rectangle, then add a shower cubicle. It is self-service."
msgstr "Arrastra un rectángulo y añade una cabina de ducha. Es autoservicio."

msgid "At least 2x2, with a shower cubicle. No staff. Each stay pays you a fee."
msgstr "Al menos 2x2, con una cabina de ducha. Sin personal. Cada uso te paga una tarifa."

msgid "Marks floor as a nap pod room. Passengers pay to rest during a long wait and gain mood."
msgstr "Marca el suelo como sala de cápsulas de descanso. Los pasajeros pagan por descansar en esperas largas y ganan ánimo."

msgid "Drag a rectangle, then add a nap pod. It is self-service."
msgstr "Arrastra un rectángulo y añade una cápsula de descanso. Es autoservicio."

msgid "At least 2x2, with a nap pod. No staff. Each stay pays you a fee."
msgstr "Al menos 2x2, con una cápsula de descanso. Sin personal. Cada uso te paga una tarifa."

msgid "A shelf unit. Each stand gives the kiosk two browse spots."
msgstr "Un expositor. Cada uno da al quiosco dos puestos para curiosear."

msgid "Inside a kiosk. Keep the cells in front clear."
msgstr "Dentro de un quiosco. Deja libres las casillas de delante."

msgid "A baggage belt. It carries checked bags from a check-in desk to a bag room."
msgstr "Una cinta de equipaje. Lleva las maletas facturadas desde un mostrador check-in a una sala de equipaje."

msgid "Drag a line. The belt shapes itself at turns and joins. Belts cannot cross."
msgstr "Arrastra una línea. La cinta toma forma en giros y uniones. Las cintas no pueden cruzarse."

msgid "Start at a check-in desk's back and end in a bag room. A wall in the way blocks it."
msgstr "Empieza detrás de un mostrador check-in y termina en una sala de equipaje. Un muro en medio la bloquea."

msgid "Where checked bags end up. They are loaded onto the plane from here."
msgstr "Adonde llegan las maletas facturadas. Desde aquí se cargan al avión."

msgid "Drag a rectangle, then run a belt into it. The belt's end piece goes inside."
msgstr "Arrastra un rectángulo y lleva una cinta dentro. La pieza final de la cinta va en el interior."

msgid "At least 2x2, with a belt end. A bag that arrives after the cutoff misses the plane."
msgstr "Al menos 2x2, con un final de cinta. Una maleta que llega tras el cierre pierde el avión."

msgid "A baggage cart on wheels."
msgstr "Un carro de equipaje sobre ruedas."

msgid "Place one in a bag room so a hired Ramp Agent drives checked bags out to the parked plane."
msgstr "Coloca uno en una sala de equipaje para que un agente de rampa lleve las maletas hasta el avión aparcado."

msgid "Needs a Ramp Agent hired in Staff. Takes 1x2 tiles; no upkeep."
msgstr "Necesita un agente de rampa contratado en Personal. Ocupa 1x2 casillas; sin mantenimiento."

msgid "A curb bay on the road outside. Cars and taxis stop here and drop passengers off."
msgstr "Un carril de parada en la carretera exterior. Coches y taxis paran aquí para dejar pasajeros."

msgid "Click one of the marked spots by the road. Each bay has two berths."
msgstr "Haz clic en uno de los espacios marcados junto a la carretera. Cada zona tiene dos plazas."

msgid "Marked spots only. The nearer an entrance, the shorter the walk."
msgstr "Solo en espacios marcados. Cuanto más cerca de una entrada, más corto el paseo."

msgid "A car park with 12 spaces. A car pays a fee when it parks."
msgstr "Un aparcamiento con 12 plazas. Cada coche paga una tarifa al aparcar."

msgid "Click a marked spot. Passengers walk from the car park to an entrance."
msgstr "Haz clic en un espacio marcado. Los pasajeros caminan del aparcamiento a una entrada."

msgid "Marked spots only. Close it to let it drain before you remove it."
msgstr "Solo en espacios marcados. Ciérralo para que se vacíe antes de quitarlo."

msgid "A big car park with 31 spaces. A car pays a higher fee than a surface lot when it parks."
msgstr "Un gran aparcamiento con 31 plazas. Cada coche paga una tarifa mayor que en el de superficie."

msgid "Opens or closes a car park."
msgstr "Abre o cierra un aparcamiento."

msgid "Click a built car park. A closed one takes no new cars and empties out."
msgstr "Haz clic en un aparcamiento construido. Cerrado no admite coches nuevos y se vacía."

msgid "A car park can only be removed once no cars are in it."
msgstr "Un aparcamiento solo puede quitarse cuando no quedan coches dentro."

msgid "Buys a plot of land. You can only build on land you own."
msgstr "Compra una parcela de terreno. Solo puedes construir en terrenos propios."

msgid "Click a highlighted plot. Its price shows on it and rises with each plot you buy."
msgstr "Haz clic en una parcela resaltada. Muestra su precio, que sube con cada parcela que compras."

msgid "A plot next to land you already own."
msgstr "Una parcela junto a un terreno que ya posees."

msgid "The tray table of a security lane, where passengers unpack their bags."
msgstr "La mesa de bandejas de un carril de seguridad, donde los pasajeros sacan sus pertenencias."

msgid "It stands beside the arch, on the side the lane's parts go."
msgstr "Se coloca junto al arco, en el lado donde van las piezas del carril."

msgid "Part of a whole lane: arch, tray table, X-ray belt and pickup table."
msgstr "Parte de un carril completo: arco, mesa de bandejas, cinta de rayos X y mesa de recogida."

msgid "The X-ray belt of a security lane. Bags ride through it."
msgstr "La cinta de rayos X de un carril de seguridad. Los bultos pasan por ella."

msgid "It stands beside the arch. A lane officer works at it."
msgstr "Se coloca junto al arco. Un agente de seguridad trabaja en ella."

msgid "Part of a whole lane. Needs a security officer hired in Staff."
msgstr "Parte de un carril completo. Necesita un agente de seguridad contratado en Personal."

msgid "The arch of a security lane. Passengers walk through it."
msgstr "El arco de un carril de seguridad. Los pasajeros pasan por él."

msgid "Place the arch first and the other parts around it. Its front faces the queue."
msgstr "Coloca primero el arco y las demás piezas alrededor. Su frente mira hacia la cola."

msgid "Part of a whole lane. Keep the spot in front and the walls around the lane clear."
msgstr "Parte de un carril completo. Deja libre delante y los muros alrededor del carril."

msgid "The pickup table of a security lane, where passengers collect their bags."
msgstr "La mesa de recogida de un carril de seguridad, donde los pasajeros recogen sus bultos."

msgid "It stands past the arch, where cleared passengers leave the lane."
msgstr "Se coloca pasado el arco, donde los pasajeros revisados salen del carril."

msgid "A bush. It calms passengers close to it, a little."
msgstr "Un arbusto. Calma un poco a los pasajeros cercanos."

msgid "Passengers within a cell or so get calm, which becomes mood. Walls block it."
msgstr "Los pasajeros a una casilla reciben calma, lo que mejora el ánimo. Los muros lo bloquean."

msgid "No upkeep. It earns nothing."
msgstr "Sin mantenimiento. No genera ingresos."

msgid "A planter. It calms passengers near it, a little."
msgstr "Una jardinera. Calma un poco a los pasajeros cercanos."

msgid "Passengers within a couple of cells get calm, which becomes mood. Walls block it."
msgstr "Los pasajeros a un par de casillas reciben calma, lo que mejora el ánimo. Los muros lo bloquean."

msgid "A large plant pot. It calms passengers near it, a little."
msgstr "Una maceta grande. Calma un poco a los pasajeros cercanos."

msgid "An indoor tree. It calms the passengers around it."
msgstr "Un árbol interior. Calma a los pasajeros de alrededor."

msgid "Passengers within a few cells get calm, which becomes mood. Walls block it."
msgstr "Los pasajeros a unas casillas de distancia reciben calma, lo que mejora el ánimo. Los muros lo bloquean."

msgid "A bench. It seats two waiting passengers and calms passengers nearby."
msgstr "Un banco. Sienta a dos pasajeros en espera y calma a los cercanos."

msgid "Gate passengers sit on it. Calm becomes mood, and a wall between them blocks it."
msgstr "Los pasajeros de la puerta se sientan en él. La calma se vuelve ánimo, y un muro en medio la bloquea."

msgid "A bench built around a tree. It calms the passengers near it."
msgstr "Un banco alrededor de un árbol. Calma a los pasajeros cercanos."

msgid "A fountain. It calms the passengers around it the most, with a long reach."
msgstr "Una fuente. Es lo que más calma a los pasajeros de alrededor, con gran alcance."

msgid "A statue. It calms the passengers around it, with a long reach."
msgstr "Una estatua. Calma a los pasajeros de alrededor, con gran alcance."

msgid "A retractable-belt stanchion post. Passengers cannot walk through it."
msgstr "Un poste separador de cinta retráctil. Los pasajeros no pueden atravesarlo."

msgid "Use stanchions and queue belts to steer a queue. They give a little calm nearby."
msgstr "Usa postes y cintas de cola para guiar filas. Aportan un poco de calma cerca."

msgid "A queue belt between two stanchions, three cells long. Passengers cannot walk through it."
msgstr "Una cinta de cola entre dos postes, de tres casillas. Los pasajeros no pueden atravesarla."

msgid "A bin. Passengers drop litter in it instead of leaving it on the floor."
msgstr "Una papelera. Los pasajeros tiran aquí la basura en vez de dejarla en el suelo."

msgid "A bin takes litter from visits near it, and a cleaner empties it when it is full."
msgstr "Una papelera recoge basura cercana, y alguien de limpieza la vacía cuando se llena."

msgid "A cleaner hired in Staff. It gives no calm, and a bin in view takes a little back."
msgstr "Limpieza contratada en Personal. No da calma, y una papelera a la vista resta un poco."

msgid "A bar counter, where guests order drinks."
msgstr "Una barra de bar, donde los clientes piden bebidas."

msgid "Place it inside a bar. A server stands behind it and guests order from the cell in front."
msgstr "Colócala dentro de un bar. Un empleado atiende detrás y los clientes piden desde la casilla frontal."

msgid "Wholly inside the bar. Shop staff hired in Staff, and the spot in front clear."
msgstr "Totalmente dentro del bar. Personal de tienda contratado en Personal y el espacio frontal libre."

msgid "A grab-and-go stall, where guests buy and walk on."
msgstr "Un puesto para llevar, donde los clientes compran y siguen su camino."

msgid "Place it inside a grab-and-go room. A server hands over the order."
msgstr "Colócalo dentro de un puesto para llevar. Un empleado entrega el pedido."

msgid "A restaurant table with four seats."
msgstr "Una mesa de restaurante con cuatro plazas."

msgid "Place it inside a restaurant. A guest walks from the counter to a free seat."
msgstr "Colócala dentro de un restaurante. El cliente camina del mostrador a un asiento libre."

msgid "Wholly inside the restaurant, with the cell behind each chair clear."
msgstr "Totalmente dentro del restaurante, con la casilla detrás de cada silla libre."

msgid "A restaurant booth with four seats."
msgstr "Un reservado de restaurante con cuatro plazas."

msgid "Wholly inside the restaurant, with the cell behind each seat clear."
msgstr "Totalmente dentro del restaurante, con la casilla detrás de cada asiento libre."

msgid "A staffed desk that helps lost passengers."
msgstr "Un mostrador con personal que ayuda a los pasajeros perdidos."

msgid "A stuck passenger nearby walks over, is helped, gains mood and plans its route again."
msgstr "Un pasajero atascado cercano se acerca, recibe ayuda, gana ánimo y vuelve a planear su ruta."

msgid "Shop staff hired in Staff, or it does nothing. Works on open floor or in a room."
msgstr "Personal de tienda contratado en Personal o no hará nada. Funciona en suelo abierto o en sala."

msgid "An information display."
msgstr "Una pantalla informativa."

msgid "Scenery for now: nothing in the game reacts to it."
msgstr "Decoración por ahora: nada en el juego reacciona a ella."

msgid "Costs upkeep every day."
msgstr "Cuesta mantenimiento cada día."

msgid "The currency exchange counter."
msgstr "El mostrador de cambio de divisas."

msgid "Place it inside an exchange room. A server stands behind it and changes money."
msgstr "Colócalo dentro de un cambio de divisas. Un empleado atiende detrás y cambia dinero."

msgid "A cash machine. One passenger uses it at a time and pays a small fee."
msgstr "Un cajero automático. Lo usa un pasajero a la vez y paga una pequeña comisión."

msgid "Place it inside an ATM room. The passenger uses it from the cell in front."
msgstr "Colócalo dentro de una sala de cajero. El pasajero lo usa desde la casilla de delante."

msgid "Keep the spot in front clear. No staff and no upkeep."
msgstr "Deja libre la casilla de delante. Sin personal ni mantenimiento."

msgid "The pharmacy counter, with a till."
msgstr "El mostrador de la farmacia, con caja registradora."

msgid "Place it inside a pharmacy. A server stands behind it."
msgstr "Colócalo dentro de una farmacia. Un empleado atiende detrás."

msgid "Wholly inside the pharmacy. Shop staff hired in Staff, and the spot in front clear."
msgstr "Totalmente dentro de la farmacia. Personal de tienda contratado en Personal y la casilla frontal libre."

msgid "A pharmacy shelf. Each one gives one browse spot."
msgstr "Una estantería de farmacia. Cada una ofrece un puesto para curiosear."

msgid "Passengers browse from the cell in front of it."
msgstr "Los pasajeros curiosean desde la casilla de delante."

msgid "Inside a pharmacy. Keep the cells in front clear."
msgstr "Dentro de una farmacia. Deja libres las casillas de delante."

msgid "A shower cubicle. One passenger uses it at a time and pays a fee."
msgstr "Una cabina de ducha. La usa un pasajero a la vez y paga una tarifa."

msgid "Place it inside a shower room. The passenger steps in from the cell in front."
msgstr "Colócala dentro de una sala de duchas. El pasajero entra desde la casilla de delante."

msgid "Keep the spot in front clear. No upkeep."
msgstr "Deja libre la casilla de delante. Sin mantenimiento."

msgid "A nap pod. One passenger uses it at a time and pays a fee."
msgstr "Una cápsula de descanso. La usa un pasajero a la vez y paga una tarifa."

msgid "Place it inside a nap pod room. The passenger sits and leans back."
msgstr "Colócala dentro de una sala de cápsulas. El pasajero se sienta y se recuesta."

msgid "A two-seat sofa. Lounge guests rest on it."
msgstr "Un sofá de dos plazas. Los visitantes de la sala VIP descansan en él."

msgid "Place it inside a lounge. Each sofa gives two seats."
msgstr "Colócalo dentro de una sala VIP. Cada sofá ofrece dos asientos."

msgid "No upkeep. The lounge is free to use."
msgstr "Sin mantenimiento. La sala VIP es gratuita."

msgid "A single armchair."
msgstr "Un sillón individual."

msgid "A passenger can sit on it, but a lounge needs a sofa. The armchair does not count."
msgstr "Un pasajero puede sentarse en él, pero una sala VIP necesita un sofá. El sillón no cuenta."

msgid "A work desk."
msgstr "Un escritorio de trabajo."

msgid "Play blocks for children."
msgstr "Bloques de juego para niños."

msgid "Place them inside a play area. A play area needs them and a slide."
msgstr "Colócalos dentro de una zona de juegos. Una zona de juegos necesita bloques y un tobogán."

msgid "No upkeep. The play area is free to use."
msgstr "Sin mantenimiento. La zona de juegos es gratuita."

msgid "A play slide. Children use it from the front."
msgstr "Un tobogán infantil. Los niños lo usan por delante."

msgid "Place it inside a play area. Each slide gives two play spots."
msgstr "Colócalo dentro de una zona de juegos. Cada tobogán ofrece dos plazas de juego."

msgid "A prize car on a podium. Passengers near it spend a bit more in shops and food rooms."
msgstr "Un coche de premio en un podio. Los pasajeros cercanos gastan algo más en tiendas y comida."

msgid "Waiting passengers who see it lose boredom. A second podium does not stack."
msgstr "Los pasajeros que esperan y lo ven pierden aburrimiento. Un segundo podio no se acumula."

msgid "Costs upkeep every day. A plain wall blocks the view."
msgstr "Cuesta mantenimiento cada día. Un muro normal bloquea la vista."

