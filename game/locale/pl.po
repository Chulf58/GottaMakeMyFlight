msgctxt "item name"
msgid "Confiscation bin"
msgstr "Pojemnik na skonfiskowane rzeczy"

msgid "An inspection table where officers check flagged carry-on bags."
msgstr "Stolik kontrolny, przy którym ochroniarze sprawdzają podejrzane bagaże podręczne."

msgid "Place it beside the lane's side berth. Optional: the lane works without one."
msgstr "Postaw z boku pasa kontroli. Opcjonalne: pas działa też bez niego."

msgid "No upkeep. Holds the passenger's tray during bag searches."
msgstr "Bez kosztów utrzymania. Mieści tackę pasażera podczas przeszukania bagażu."

msgid "A clear glass bin showing items taken at the security lane today."
msgstr "Przezroczysty szklany pojemnik pokazujący przedmioty zatrzymane dziś na kontroli."

msgid "Place it next to the search table slot. Resets at midnight."
msgstr "Postaw obok miejsca na stolik kontroli. Opróżnia się o północy."

msgid "No upkeep. Inspect it to see today's strangest finds."
msgstr "Bez kosztów utrzymania. Kliknij, aby zobaczyć najdziwniejsze dzisiejsze znaleziska."

msgid "Status: Attached to a ready security lane"
msgstr "Status: Podpięty do gotowego pasa kontroli"

msgid "Status: Not attached to a ready lane"
msgstr "Status: Niepodpięty do gotowego pasa"

