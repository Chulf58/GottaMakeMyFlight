# Curated T8 verification catalog for pl.
msgid ""
msgstr ""
"Project-Id-Version: Gotta Make My Flight\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<12 || n%100>14) ? 1 : 2);\n"

msgid "No flights yet"
msgstr "Brak lotów"

msgid "No flights yet: the rating starts when passengers make or miss a flight."
msgstr "Brak lotów: ocena zaczyna się, gdy pasażerowie zdążą na lot lub go przegapią."

msgid "Made it: {share}% ({made} of {count} passenger)"
msgid_plural "Made it: {share}% ({made} of {count} passengers)"
msgstr[0] "Zdążyło: {share}% ({made} z {count} pasażera)"
msgstr[1] "Zdążyło: {share}% ({made} z {count} pasażerów)"
msgstr[2] "Zdążyło: {share}% ({made} z {count} pasażerów)"

msgid "Airport rating: {stars} of {max}"
msgstr "Ocena lotniska: {stars} z {max}"

msgid "Mood: {mood} of {max}"
msgstr "Nastrój: {mood} z {max}"

msgid "Incident adjustment: {amount} stars"
msgstr "Korekta za zdarzenia: {amount} gwiazdek"

msgid "Days counted: {days} of {window}"
msgstr "Policzone dni: {days} z {window}"

msgid "Floor tile. Passengers can only walk and stand on floor."
msgstr "Płytka podłogi. Pasażerowie mogą chodzić i stać tylko na podłodze."

msgid "Drag a rectangle to lay many tiles at once. Everything else is built on floor."
msgstr "Przeciągnij prostokąt, aby ułożyć wiele płytek naraz. Wszystko inne buduje się na podłodze."

msgid "Land you own. Removing a tile refunds half."
msgstr "Teren należący do ciebie. Usunięcie płytki zwraca połowę kosztu."

msgid "A wall along a tile edge. Passengers cannot cross it and it blocks the view."
msgstr "Ściana na krawędzi płytki. Pasażerowie przez nią nie przejdą i zasłania widok."

msgid "Drag along a line to build a row. Walls close in the terminal and its rooms."
msgstr "Przeciągnij wzdłuż linii, aby postawić rząd ścian. Ściany zamykają terminal i pomieszczenia."

msgid "One wall per tile edge. Removing it refunds half."
msgstr "Jedna ściana na krawędź płytki. Usunięcie zwraca połowę kosztu."

msgid "A glass wall. Passengers cannot cross it, but it lets the view through."
msgstr "Szklana ściana. Pasażerowie przez nią nie przejdą, ale przepuszcza widok."

msgid "Drag along a line like a wall. Screens and decor can be seen through glass."
msgstr "Przeciągnij wzdłuż linii jak zwykłą ścianę. Ekrany i dekoracje widać przez szkło."

msgid "Costs more than a plain wall. One per tile edge."
msgstr "Kosztuje więcej niż zwykła ściana. Jedna na krawędź płytki."

msgid "A door in a wall. Passengers walk through it."
msgstr "Drzwi w ścianie. Pasażerowie przechodzą przez nie."

msgid "Click a wall edge to put a door in the wall."
msgstr "Kliknij krawędź ściany, aby wstawić drzwi."

msgid "A plain wall on each side of it."
msgstr "Zwykła ściana po obu stronach drzwi."

msgid "The way into the terminal. Passengers come in here from the road and car parks."
msgstr "Wejście do terminalu. Pasażerowie wchodzą tędy z ulicy i parkingów."

msgid "Place it on the outer edge of the terminal, facing in."
msgstr "Umieść na zewnętrznej krawędzi terminalu, przodem do środka."

msgid "The outside edge with no floor behind it. Keep the spot in front clear."
msgstr "Zewnętrzna krawędź bez podłogi z tyłu. Zostaw wolne miejsce z przodu."

msgid "The way out to the planes. Passengers leave the terminal here to board."
msgstr "Wyjście do samolotów. Pasażerowie opuszczają tędy terminal przed wejściem na pokład."

msgid "Place it on the outer edge. A gate desk links to an exit facing west, north or east."
msgstr "Umieść na zewnętrznej krawędzi. Stanowisko przy bramce łączy się z wyjściem na zachód, północ lub wschód."

msgid "Where passengers check in and hand over a bag."
msgstr "Miejsce, gdzie pasażerowie przechodzą odprawę i nadają bagaż."

msgid "A check-in agent works behind it. A belt from its back edge takes bags to a bag room."
msgstr "Za stanowiskiem pracuje obsługa odprawy. Taśma z tyłu zabiera bagaże do bagażowni."

msgid "An agent hired in Staff, or it stays closed. Keep the spot behind and in front clear."
msgstr "Wymaga pracownika z zakładki Personel, inaczej jest zamknięte. Zostaw wolne miejsce z przodu i z tyłu."

msgid "A basic security scanner. Passengers walk through it to be screened."
msgstr "Podstawowy skaner bezpieczeństwa. Pasażerowie przechodzą przez niego do kontroli."

msgid "A security officer works beside it. A full lane is faster but costs more."
msgstr "Obok pracuje ochroniarz. Pełny pas kontroli jest szybszy, ale droższy."

msgid "An officer hired in Staff, or it stays closed. Keep its staff spot and way in clear."
msgstr "Wymaga ochroniarza z zakładki Personel, inaczej jest zamknięty. Zostaw wolne stanowisko i wejście."

msgid "A row of seats. Passengers wait here for their flight and their mood recovers."
msgstr "Rząd siedzeń. Pasażerowie czekają tu na lot i poprawiają sobie nastrój."

msgid "Place it near the gate and turn it. Waiting passengers sit on it."
msgstr "Ustaw blisko bramki i obróć. Czekający pasażerowie na niej usiądą."

msgid "No staff and no upkeep. Add enough seats for the passengers waiting."
msgstr "Bez personelu i kosztów utrzymania. Dodaj dość miejsc dla czekających pasażerów."

msgid "Makes a gate. It links to the nearest free exit facing the planes; the plane parks out from it."
msgstr "Tworzy bramkę. Łączy się z najbliższym wolnym wyjściem na płytę; samolot parkuje przed nim."

msgid "Each flight is given a gate. A gate takes the next free letter, starting at A."
msgstr "Każdy lot dostaje bramkę. Bramki otrzymują kolejne wolne litery od A."

msgid "Within 4 cells of a free exit facing the planes, with room for the plane. No staff needed."
msgstr "W zasięgu 4 pól od wolnego wyjścia na płytę, z miejscem na samolot. Bez dodatkowego personelu."

msgid "A floor screen that entertains passengers waiting in front of it."
msgstr "Wolnostojący ekran, który zabawia pasażerów czekających przed nim."

msgid "It covers a fan of floor up to 5 rows ahead. A plain wall blocks it, glass does not."
msgstr "Obejmuje wachlarz pól do 5 rzędów naprzód. Zwykła ściana go blokuje, szkło nie."

msgid "Costs upkeep every day, inside a room or not."
msgstr "Generuje codzienne koszty utrzymania, niezależnie od tego, czy stoi w pomieszczeniu."

msgid "Marks floor as a cafe. Hungry passengers eat and drink here and their mood rises."
msgstr "Oznacza podłogę jako kawiarnię. Głodni pasażerowie jedzą tu, piją i poprawiają nastrój."

msgid "Drag a rectangle, then add a counter and a table. Guests order, then sit at the table."
msgstr "Przeciągnij prostokąt, potem dodaj ladę i stolik. Goście zamawiają i siadają przy stoliku."

msgid "At least 3x3, with a counter and a table. Needs shop staff, or the counter stays closed."
msgstr "Co najmniej 3x3, z ladą i stolikiem. Wymaga sprzedawcy, inaczej lada będzie zamknięta."

msgid "The cafe counter, where guests order."
msgstr "Lada kawiarni, przy której goście składają zamówienia."

msgid "Place it inside a cafe or restaurant. A server stands there."
msgstr "Umieść w kawiarni lub restauracji. Stoi za nią sprzedawca."

msgid "Wholly inside the room. Shop staff hired in Staff, and the spot in front clear."
msgstr "W całości w pomieszczeniu. Wymaga sprzedawcy z zakładki Personel i wolnego miejsca z przodu."

msgid "A table with a seat at each end. Cafe guests sit here to eat."
msgstr "Stolik z miejscami na obu końcach. Goście kawiarni jedzą przy nim posiłki."

msgid "It seats two. A guest walks from the counter to a free seat."
msgstr "Mieści dwie osoby. Gość idzie od lady do wolnego krzesła."

msgid "Inside a cafe. A bar uses bar counters, and a restaurant uses dining tables or booths."
msgstr "Wewnątrz kawiarni. Bar używa baru, a restauracja stołów lub boksów."

msgid "Marks floor as a toilet. Passengers who need one queue and use a stall."
msgstr "Oznacza podłogę jako toaletę. Potrzebujący pasażerowie stają w kolejce i korzystają z kabin."

msgid "Drag a rectangle, then add a stall and a sink inside."
msgstr "Przeciągnij prostokąt, a potem wstaw kabinę i umywalkę w środku."

msgid "At least 2x3, with a stall and a sink. Each stall costs upkeep every day when ready."
msgstr "Co najmniej 2x3, z kabiną i umywalką. Każda kabina ma dzienny koszt utrzymania po otwarciu."

msgid "One toilet stall. One passenger uses it at a time."
msgstr "Pojedyncza kabina toaletowa. Korzysta z niej jeden pasażer naraz."

msgid "Place it inside a toilet room. A passenger walks in from the cell in front."
msgstr "Umieść wewnątrz toalety. Pasażer wchodzi z pola przed kabiną."

msgid "Keep the spot in front clear. Costs upkeep every day once its room is ready."
msgstr "Zostaw wolne miejsce z przodu. Kosztuje codziennie po ukończeniu pomieszczenia."

msgid "A sink. A toilet room is not ready without one."
msgstr "Umywalka. Bez niej toaleta nie będzie gotowa."

msgid "Place it inside a toilet room."
msgstr "Umieść wewnątrz toalety."

msgid "Keep the spot in front clear. No upkeep of its own."
msgstr "Zostaw wolne miejsce z przodu. Bez własnych kosztów utrzymania."

msgid "Marks floor as a kiosk, a small shop. Bored passengers browse here and pay."
msgstr "Oznacza podłogę jako kiosk, mały sklep. Znudzeni pasażerowie oglądają tu towary i płacą."

msgid "Drag a rectangle, then add a counter and display stands. Guests browse at the stands."
msgstr "Przeciągnij prostokąt, potem dodaj ladę i stojaki. Klienci przeglądają towar przy stojakach."

msgid "At least 3x3, with a counter and a display stand. Shop staff serve at the counter."
msgstr "Co najmniej 3x3, z ladą i stojakiem. Sprzedawcy obsługują przy ladzie."

msgid "The kiosk's counter, with a till."
msgstr "Lada kiosku z kasą."

msgid "Place it inside a kiosk. A server stands behind it."
msgstr "Umieść wewnątrz kiosku. Za ladą stoi sprzedawca."

msgid "Wholly inside the kiosk. Shop staff hired in Staff, and the spot in front clear."
msgstr "W całości w kiosku. Wymaga sprzedawcy z zakładki Personel i wolnego miejsca z przodu."

msgid "Marks floor as a pharmacy. Passengers browse and buy here."
msgstr "Oznacza podłogę jako aptekę. Pasażerowie przeglądają tu towary i robią zakupy."

msgid "Drag a rectangle, then add a counter and a shelf. Passengers browse at the shelf."
msgstr "Przeciągnij prostokąt, potem dodaj ladę i regał. Pasażerowie wybierają produkty z regału."

msgid "At least 3x3, with a counter and a shelf. Shop staff serve at the counter."
msgstr "Co najmniej 3x3, z ladą i regałem. Sprzedawcy obsługują przy ladzie."

msgid "Marks floor as a duty free shop. Passengers browse and spend more than in a kiosk."
msgstr "Oznacza podłogę jako sklep duty free. Pasażerowie oglądają tu towary i wydają więcej niż w kiosku."

msgid "Drag a rectangle, then add a till and shelves. Passengers browse at the shelves."
msgstr "Przeciągnij prostokąt, potem dodaj kasę i półki. Pasażerowie wybierają towary z półek."

msgid "At least 3x4, with a till and a shelf. Shop staff serve at the till."
msgstr "Co najmniej 3x4, z kasą i półką. Sprzedawcy obsługują przy kasie."

msgid "The duty free shop's till."
msgstr "Kasa w sklepie duty free."

msgid "Place it inside a duty free shop. A server stands behind it."
msgstr "Umieść wewnątrz sklepu duty free. Za kasą stoi sprzedawca."

msgid "Wholly inside the shop. Shop staff hired in Staff, and the spot in front clear."
msgstr "W całości w sklepie. Wymaga sprzedawcy z zakładki Personel i wolnego miejsca z przodu."

msgid "A duty free shelf. Each one gives two browse spots."
msgstr "Półka duty free. Każda daje dwa miejsca do przeglądania towarów."

msgid "Passengers browse from the cells in front of it."
msgstr "Pasażerowie przeglądają towary z pól przed półką."

msgid "Inside a duty free shop. Keep the cells in front clear."
msgstr "Wewnątrz sklepu duty free. Zostaw wolne pola z przodu."

msgid "Marks floor as a fashion store. Passengers browse and spend more than in a kiosk."
msgstr "Oznacza podłogę jako sklep z modą. Pasażerowie przeglądają ofertę i wydają więcej niż w kiosku."

msgid "Drag a rectangle, then add a till and clothes rails. Passengers browse at the rails."
msgstr "Przeciągnij prostokąt, potem dodaj kasę i wieszaki. Pasażerowie przeglądają ubrania na wieszakach."

msgid "At least 3x4, with a till and a clothes rail. Shop staff serve at the till."
msgstr "Co najmniej 3x4, z kasą i wieszakiem. Sprzedawcy obsługują przy kasie."

msgid "The fashion store's till."
msgstr "Kasa w sklepie z modą."

msgid "Place it inside a fashion store. A server stands behind it."
msgstr "Umieść wewnątrz sklepu z modą. Za kasą stoi sprzedawca."

msgid "Wholly inside the store. Shop staff hired in Staff, and the spot in front clear."
msgstr "W całości w sklepie. Wymaga sprzedawcy z zakładki Personel i wolnego miejsca z przodu."

msgid "A clothes rail. Each one gives two browse spots."
msgstr "Wieszak na ubrania. Każdy daje dwa miejsca do przeglądania."

msgid "Inside a fashion store. Keep the cells in front clear."
msgstr "Wewnątrz sklepu z modą. Zostaw wolne pola z przodu."

msgid "Marks floor as a currency exchange. Passengers change money and pay a small fee."
msgstr "Oznacza podłogę jako kantor. Pasażerowie wymieniają pieniądze i płacą drobną prowizję."

msgid "Drag a rectangle, then add a counter. A server works it."
msgstr "Przeciągnij prostokąt, potem dodaj ladę. Pracuje przy niej sprzedawca."

msgid "At least 2x3, with a counter and shop staff. A visit does not cure boredom."
msgstr "Co najmniej 2x3, z ladą i sprzedawcą. Wizyta nie zmniejsza nudy."

msgid "Marks floor as an ATM room. Passengers take out cash and pay a small fee."
msgstr "Oznacza podłogę jako punkt z bankomatem. Pasażerowie wypłacają gotówkę i płacą prowizję."

msgid "Drag a rectangle, then add an ATM. It is self-service."
msgstr "Przeciągnij prostokąt, potem dodaj bankomat. Jest samoobsługowy."

msgid "At least 1x2, with an ATM. No staff. A visit does not cure boredom."
msgstr "Co najmniej 1x2, z bankomatem. Bez personelu. Wizyta nie zmniejsza nudy."

msgid "Marks floor as a bar. Guests stay longer than in a cafe, spend more, and gain most mood."
msgstr "Oznacza podłogę jako bar. Goście zostają dłużej niż w kawiarni, wydają więcej i zyskują najwięcej nastroju."

msgid "Guests order at a bar counter and sit on its stools."
msgstr "Goście zamawiają przy ladzie barowej i siadają na stołkach."

msgid "At least 3x4, with a bar counter. Shop staff serve at the counter."
msgstr "Co najmniej 3x4, z ladą barową. Sprzedawcy obsługują przy barze."

msgid "Marks floor as a sit-down restaurant. Guests stay the longest and spend the most."
msgstr "Oznacza podłogę jako restaurację. Goście zostają najdłużej i wydają najwięcej."

msgid "Guests order at a cafe counter and sit at a dining table or a booth."
msgstr "Goście zamawiają przy ladzie i siadają przy stoliku restauracyjnym lub w boksie."

msgid "At least 4x4, with a counter and a table or booth. Shop staff serve at the counter."
msgstr "Co najmniej 4x4, z ladą i stolikiem lub boksem. Sprzedawcy obsługują przy ladzie."

msgid "Marks floor as a grab-and-go stall. Guests buy, pay and walk on, with no seat."
msgstr "Oznacza podłogę jako punkt na wynos. Goście kupują, płacą i idą dalej, bez siedzenia."

msgid "It needs only a grab-and-go stall. A server hands over the order."
msgstr "Wymaga tylko stoiska na wynos. Sprzedawca podaje zamówienie."

msgid "At least 3x3, with a counter. Shop staff serve. It earns the least of the food rooms."
msgstr "Co najmniej 3x3, z ladą. Obsługują sprzedawcy. Zarabia najmniej spośród lokali gastronomicznych."

msgid "Marks floor as a play area. Passengers stay and play for free and their mood rises."
msgstr "Oznacza podłogę jako kącik zabaw. Pasażerowie bawią się za darmo, a ich nastrój rośnie."

msgid "Drag a rectangle, then add a slide and play blocks. It is self-service."
msgstr "Przeciągnij prostokąt, potem dodaj zjeżdżalnię i klocki. Strefa samoobsługowa."

msgid "At least 3x4, with a slide and play blocks. No staff."
msgstr "Co najmniej 3x4, ze zjeżdżalnią i klockami. Bez personelu."

msgid "Marks floor as a lounge. Passengers rest on the sofas for free and their mood rises."
msgstr "Oznacza podłogę jako poczekalnię lounge. Pasażerowie odpoczywają na kanapach za darmo i rośnie im nastrój."

msgid "Drag a rectangle, then add a sofa. It is self-service."
msgstr "Przeciągnij prostokąt, potem dodaj kanapę. Strefa samoobsługowa."

msgid "At least 2x3, with a sofa. No staff."
msgstr "Co najmniej 2x3, z kanapą. Bez personelu."

msgid "Marks floor as a shower room. Passengers pay to wash during a long wait and gain mood."
msgstr "Oznacza podłogę jako prysznice. Pasażerowie płacą za prysznic przy długim czekaniu i poprawiają nastrój."

msgid "Drag a rectangle, then add a shower cubicle. It is self-service."
msgstr "Przeciągnij prostokąt, potem dodaj kabinę prysznicową. Strefa samoobsługowa."

msgid "At least 2x2, with a shower cubicle. No staff. Each stay pays you a fee."
msgstr "Co najmniej 2x2, z kabiną prysznicową. Bez personelu. Każda wizyta daje opłatę."

msgid "Marks floor as a nap pod room. Passengers pay to rest during a long wait and gain mood."
msgstr "Oznacza podłogę jako pokój z kapsułami do spania. Pasażerowie płacą za odpoczynek podczas długiego czekania."

msgid "Drag a rectangle, then add a nap pod. It is self-service."
msgstr "Przeciągnij prostokąt, potem dodaj kapsułę do spania. Strefa samoobsługowa."

msgid "At least 2x2, with a nap pod. No staff. Each stay pays you a fee."
msgstr "Co najmniej 2x2, z kapsułą do spania. Bez personelu. Każda wizyta daje opłatę."

msgid "A shelf unit. Each stand gives the kiosk two browse spots."
msgstr "Regał wystawowy. Każdy stojak daje w kiosku dwa miejsca do przeglądania."

msgid "Inside a kiosk. Keep the cells in front clear."
msgstr "Wewnątrz kiosku. Zostaw wolne pola z przodu."

msgid "A baggage belt. It carries checked bags from a check-in desk to a bag room."
msgstr "Taśma bagażowa. Przenosi nadane bagaże ze stanowiska odprawy do bagażowni."

msgid "Drag a line. The belt shapes itself at turns and joins. Belts cannot cross."
msgstr "Przeciągnij linię. Taśma sama układa zakręty i połączenia. Taśmy nie mogą się krzyżować."

msgid "Start at a check-in desk's back and end in a bag room. A wall in the way blocks it."
msgstr "Zacznij za stanowiskiem odprawy i zakończ w bagażowni. Ściana na trasie ją blokuje."

msgid "Where checked bags end up. They are loaded onto the plane from here."
msgstr "Miejsce, dokąd trafiają nadane bagaże. Stąd są ładowane do samolotu."

msgid "Drag a rectangle, then run a belt into it. The belt's end piece goes inside."
msgstr "Przeciągnij prostokąt i doprowadź taśmę do środka. Końcówka taśmy wchodzi do wnętrza."

msgid "At least 2x2, with a belt end. A bag that arrives after the cutoff misses the plane."
msgstr "Co najmniej 2x2, z końcówką taśmy. Bagaż przybyły po czasie nie zdąży na samolot."

msgid "A baggage cart on wheels."
msgstr "Wózek bagażowy na kółkach."

msgid "Place one in a bag room so a hired Ramp Agent drives checked bags out to the parked plane."
msgstr "Ustaw go w bagażowni, aby obsługa płyty zawoziła bagaże do zaparkowanego samolotu."

msgid "Needs a Ramp Agent hired in Staff. Takes 1x2 tiles; no upkeep."
msgstr "Wymaga pracownika obsługi płyty z zakładki Personel. Zajmuje 1x2 pola; bez utrzymania."

msgid "A curb bay on the road outside. Cars and taxis stop here and drop passengers off."
msgstr "Zatoka przy drodze przed terminalem. Auta i taksówki zatrzymują się tu, wysadzając pasażerów."

msgid "Click one of the marked spots by the road. Each bay has two berths."
msgstr "Kliknij jedno z oznaczonych miejsc przy drodze. Każda zatoka ma dwa stanowiska."

msgid "Marked spots only. The nearer an entrance, the shorter the walk."
msgstr "Tylko w oznaczonych miejscach. Im bliżej wejścia, tym krótsza droga."

msgid "A car park with 12 spaces. A car pays a fee when it parks."
msgstr "Parking z 12 miejscami. Każde auto płaci opłatę za postój."

msgid "Click a marked spot. Passengers walk from the car park to an entrance."
msgstr "Kliknij oznaczone miejsce. Pasażerowie idą z parkingu do wejścia."

msgid "Marked spots only. Close it to let it drain before you remove it."
msgstr "Tylko w oznaczonych miejscach. Zamknij go i poczekaj na opróżnienie przed usunięciem."

msgid "A big car park with 31 spaces. A car pays a higher fee than a surface lot when it parks."
msgstr "Duży parking z 31 miejscami. Opłata za auto jest wyższa niż na parkingu naziemnym."

msgid "Opens or closes a car park."
msgstr "Otwiera lub zamyka parking."

msgid "Click a built car park. A closed one takes no new cars and empties out."
msgstr "Kliknij zbudowany parking. Zamknięty nie przyjmuje nowych aut i stopniowo pustoszeje."

msgid "A car park can only be removed once no cars are in it."
msgstr "Parking można usunąć dopiero wtedy, gdy nie ma na nim żadnych aut."

msgid "Buys a plot of land. You can only build on land you own."
msgstr "Kupuje działkę. Możesz budować wyłącznie na własnym terenie."

msgid "Click a highlighted plot. Its price shows on it and rises with each plot you buy."
msgstr "Kliknij podświetloną działkę. Cena widnieje na niej i rośnie z każdym kolejnym zakupem."

msgid "A plot next to land you already own."
msgstr "Działka sąsiadująca z terenem, który już posiadasz."

msgid "The tray table of a security lane, where passengers unpack their bags."
msgstr "Stolik na tacki przy pasie kontroli, gdzie pasażerowie rozpakowują bagaż."

msgid "It stands beside the arch, on the side the lane's parts go."
msgstr "Stoi obok bramki, po stronie pozostałych elementów pasa kontroli."

msgid "Part of a whole lane: arch, tray table, X-ray belt and pickup table."
msgstr "Część pełnego pasa kontroli: bramka, stolik na tacki, taśma RTG i stolik odbioru."

msgid "The X-ray belt of a security lane. Bags ride through it."
msgstr "Taśma rentgenowska pasa kontroli. Przejeżdżają przez nią bagaże."

msgid "It stands beside the arch. A lane officer works at it."
msgstr "Stoi obok bramki. Przy niej pracuje ochroniarz."

msgid "Part of a whole lane. Needs a security officer hired in Staff."
msgstr "Część pełnego pasa kontroli. Wymaga ochroniarza z zakładki Personel."

msgid "The arch of a security lane. Passengers walk through it."
msgstr "Bramka pasa kontroli. Przechodzą przez nią pasażerowie."

msgid "Place the arch first and the other parts around it. Its front faces the queue."
msgstr "Najpierw postaw bramkę, a potem resztę elementów wokół niej. Przód kieruj do kolejki."

msgid "Part of a whole lane. Keep the spot in front and the walls around the lane clear."
msgstr "Część pełnego pasa kontroli. Zostaw wolne miejsce z przodu i ściany wokół pasa."

msgid "The pickup table of a security lane, where passengers collect their bags."
msgstr "Stolik odbioru przy pasie kontroli, gdzie pasażerowie odbierają swoje rzeczy."

msgid "It stands past the arch, where cleared passengers leave the lane."
msgstr "Stoi za bramką, tam gdzie sprawdzeni pasażerowie opuszczają pas kontroli."

msgid "A bush. It calms passengers close to it, a little."
msgstr "Krzew. Lekko uspokaja pobliskich pasażerów."

msgid "Passengers within a cell or so get calm, which becomes mood. Walls block it."
msgstr "Pasażerowie w promieniu jednego pola nabierają spokoju, co poprawia nastrój. Ściany to blokują."

msgid "No upkeep. It earns nothing."
msgstr "Bez kosztów utrzymania. Nic nie zarabia."

msgid "A planter. It calms passengers near it, a little."
msgstr "Donica z rośliną. Lekko uspokaja pobliskich pasażerów."

msgid "Passengers within a couple of cells get calm, which becomes mood. Walls block it."
msgstr "Pasażerowie w promieniu paru pól nabierają spokoju, co poprawia nastrój. Ściany to blokują."

msgid "A large plant pot. It calms passengers near it, a little."
msgstr "Duża donica z rośliną. Lekko uspokaja pobliskich pasażerów."

msgid "An indoor tree. It calms the passengers around it."
msgstr "Drzewko wewnętrzne. Uspokaja pasażerów wokół."

msgid "Passengers within a few cells get calm, which becomes mood. Walls block it."
msgstr "Pasażerowie w promieniu kilku pól nabierają spokoju, co poprawia nastrój. Ściany to blokują."

msgid "A bench. It seats two waiting passengers and calms passengers nearby."
msgstr "Ławka. Mieści dwóch czekających pasażerów i uspokaja osoby w pobliżu."

msgid "Gate passengers sit on it. Calm becomes mood, and a wall between them blocks it."
msgstr "Siadają na niej pasażerowie przy bramce. Spokój poprawia nastrój, ale ściana go blokuje."

msgid "A bench built around a tree. It calms the passengers near it."
msgstr "Ławka wokół drzewa. Uspokaja pobliskich pasażerów."

msgid "A fountain. It calms the passengers around it the most, with a long reach."
msgstr "Fontanna. Najmocniej uspokaja pasażerów wokół i ma duży zasięg."

msgid "A statue. It calms the passengers around it, with a long reach."
msgstr "Posąg. Uspokaja pasażerów wokół i ma duży zasięg."

msgid "A retractable-belt stanchion post. Passengers cannot walk through it."
msgstr "Słupek odgradzający z taśmą. Pasażerowie przez niego nie przejdą."

msgid "Use stanchions and queue belts to steer a queue. They give a little calm nearby."
msgstr "Użyj słupków i taśm kolejkowych do kierowania ruchem. Dają też nieco spokoju w pobliżu."

msgid "A queue belt between two stanchions, three cells long. Passengers cannot walk through it."
msgstr "Taśma kolejkowa między dwoma słupkami o długości trzech pól. Pasażerowie nie przejdą."

msgid "A bin. Passengers drop litter in it instead of leaving it on the floor."
msgstr "Kosz na śmieci. Pasażerowie wrzucają tu odpadki zamiast rzucać je na podłogę."

msgid "A bin takes litter from visits near it, and a cleaner empties it when it is full."
msgstr "Kosz zbiera śmieci z okolicy, a sprzątacz opróżnia go po zapełnieniu."

msgid "A cleaner hired in Staff. It gives no calm, and a bin in view takes a little back."
msgstr "Wymaga sprzątacza z zakładki Personel. Nie uspokaja, a kosz na widoku nieco psuje efekt."

msgid "A bar counter, where guests order drinks."
msgstr "Lada barowa, przy której goście zamawiają napoje."

msgid "Place it inside a bar. A server stands behind it and guests order from the cell in front."
msgstr "Umieść wewnątrz baru. Za ladą stoi sprzedawca, a goście zamawiają z pola z przodu."

msgid "Wholly inside the bar. Shop staff hired in Staff, and the spot in front clear."
msgstr "W całości w barze. Wymaga sprzedawcy z zakładki Personel i wolnego miejsca z przodu."

msgid "A grab-and-go stall, where guests buy and walk on."
msgstr "Stoisko na wynos, gdzie goście kupują i idą dalej."

msgid "Place it inside a grab-and-go room. A server hands over the order."
msgstr "Umieść wewnątrz punktu na wynos. Sprzedawca podaje zamówienie."

msgid "A restaurant table with four seats."
msgstr "Stolik restauracyjny z czterema miejscami."

msgid "Place it inside a restaurant. A guest walks from the counter to a free seat."
msgstr "Umieść wewnątrz restauracji. Gość idzie od lady do wolnego miejsca."

msgid "Wholly inside the restaurant, with the cell behind each chair clear."
msgstr "W całości w restauracji, z wolnym polem za każdym krzesłem."

msgid "A restaurant booth with four seats."
msgstr "Boks restauracyjny z czterema miejscami."

msgid "Wholly inside the restaurant, with the cell behind each seat clear."
msgstr "W całości w restauracji, z wolnym polem za każdym siedziskiem."

msgid "A staffed desk that helps lost passengers."
msgstr "Punkt informacyjny z obsługą pomagającą zagubionym pasażerom."

msgid "A stuck passenger nearby walks over, is helped, gains mood and plans its route again."
msgstr "Zagubiony pasażer podchodzi, otrzymuje pomoc, poprawia nastrój i wyznacza trasę na nowo."

msgid "Shop staff hired in Staff, or it does nothing. Works on open floor or in a room."
msgstr "Wymaga sprzedawcy z zakładki Personel, inaczej nie działa. Działa na otwartej przestrzeni i w pokoju."

msgid "An information display."
msgstr "Tablica informacyjna."

msgid "Scenery for now: nothing in the game reacts to it."
msgstr "Na razie to tylko dekoracja: nic w grze z nią nie wchodzi w interakcję."

msgid "Costs upkeep every day."
msgstr "Generuje codzienne koszty utrzymania."

msgid "The currency exchange counter."
msgstr "Lada kantoru wymiany walut."

msgid "Place it inside an exchange room. A server stands behind it and changes money."
msgstr "Umieść w kantorze. Za ladą stoi sprzedawca i wymienia pieniądze."

msgid "A cash machine. One passenger uses it at a time and pays a small fee."
msgstr "Bankomat. Korzysta z niego jeden pasażer naraz, płacąc drobną prowizję."

msgid "Place it inside an ATM room. The passenger uses it from the cell in front."
msgstr "Umieść w pokoju z bankomatem. Pasażer korzysta z niego z pola z przodu."

msgid "Keep the spot in front clear. No staff and no upkeep."
msgstr "Zostaw wolne miejsce z przodu. Bez personelu i kosztów utrzymania."

msgid "The pharmacy counter, with a till."
msgstr "Lada apteki z kasą."

msgid "Place it inside a pharmacy. A server stands behind it."
msgstr "Umieść wewnątrz apteki. Za ladą stoi sprzedawca."

msgid "Wholly inside the pharmacy. Shop staff hired in Staff, and the spot in front clear."
msgstr "W całości w aptece. Wymaga sprzedawcy z zakładki Personel i wolnego miejsca z przodu."

msgid "A pharmacy shelf. Each one gives one browse spot."
msgstr "Regał apteczny. Każdy daje jedno miejsce do przeglądania."

msgid "Passengers browse from the cell in front of it."
msgstr "Pasażerowie przeglądają produkty z pola przed regałem."

msgid "Inside a pharmacy. Keep the cells in front clear."
msgstr "Wewnątrz apteki. Zostaw wolne pola z przodu."

msgid "A shower cubicle. One passenger uses it at a time and pays a fee."
msgstr "Kabina prysznicowa. Korzysta z niej jeden pasażer naraz za opłatą."

msgid "Place it inside a shower room. The passenger steps in from the cell in front."
msgstr "Umieść w pomieszczeniu z prysznicem. Pasażer wchodzi z pola z przodu."

msgid "Keep the spot in front clear. No upkeep."
msgstr "Zostaw wolne miejsce z przodu. Bez kosztów utrzymania."

msgid "A nap pod. One passenger uses it at a time and pays a fee."
msgstr "Kapsuła do spania. Korzysta z niej jeden pasażer naraz za opłatą."

msgid "Place it inside a nap pod room. The passenger sits and leans back."
msgstr "Umieść w pokoju z kapsułami. Pasażer siada i odchyla się do tyłu."

msgid "A two-seat sofa. Lounge guests rest on it."
msgstr "Dwuosobowa kanapa. Goście poczekalni lounge na niej odpoczywają."

msgid "Place it inside a lounge. Each sofa gives two seats."
msgstr "Umieść wewnątrz poczekalni lounge. Każda kanapa daje dwa miejsca."

msgid "No upkeep. The lounge is free to use."
msgstr "Bez kosztów utrzymania. Wstęp do lounge jest darmowy."

msgid "A single armchair."
msgstr "Pojedynczy fotel."

msgid "A passenger can sit on it, but a lounge needs a sofa. The armchair does not count."
msgstr "Pasażer może na nim usiąść, ale lounge wymaga kanapy. Fotel się nie liczy."

msgid "A work desk."
msgstr "Biurko do pracy."

msgid "Play blocks for children."
msgstr "Klocki do zabawy dla dzieci."

msgid "Place them inside a play area. A play area needs them and a slide."
msgstr "Umieść w kąciku zabaw. Kącik potrzebuje klocków i zjeżdżalni."

msgid "No upkeep. The play area is free to use."
msgstr "Bez kosztów utrzymania. Kącik zabaw jest darmowy."

msgid "A play slide. Children use it from the front."
msgstr "Zjeżdżalnia. Dzieci wchodzą na nią od przodu."

msgid "Place it inside a play area. Each slide gives two play spots."
msgstr "Umieść w kąciku zabaw. Każda zjeżdżalnia daje dwa miejsca do zabawy."

msgid "A prize car on a podium. Passengers near it spend a bit more in shops and food rooms."
msgstr "Nagroda samochodowa na podeście. Pasażerowie w pobliżu wydają nieco więcej w sklepach i gastronomii."

msgid "Waiting passengers who see it lose boredom. A second podium does not stack."
msgstr "Czekający pasażerowie patrząc na niego mniej się nudzą. Drugi podest nie kumuluje efektu."

msgid "Costs upkeep every day. A plain wall blocks the view."
msgstr "Generuje codzienne koszty utrzymania. Zwykła ściana zasłania widok."

