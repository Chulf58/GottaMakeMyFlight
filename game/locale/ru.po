msgctxt "pa"
msgid "PA: A seasonal rush is arriving. Everyone is early except the queue."
msgstr "ГГС: Ожидается сезонный наплыв пассажиров. Все приехали заранее, кроме самой очереди."

msgctxt "pa"
msgid "PA: Check-in queue is full. Please admire the terminal flooring while waiting."
msgstr "ГГС: Очередь на регистрацию заполнена. Пока ждёте, полюбуйтесь напольным покрытием терминала."

msgctxt "pa"
msgid "PA: Security queue is full. Take a moment to pre-untie your shoes."
msgstr "ГГС: Очередь на досмотр заполнена. Самое время заранее развязать шнурки."

msgctxt "pa"
msgid "PA: Bravo to the passenger who caught {airline} to {city} at Gate {gate} just in time."
msgstr "ГГС: Браво пассажиру, который в последний миг успел на рейс {airline} в {city} у выхода {gate}."

msgctxt "pa"
msgid "PA: Bravo to the passenger who caught {airline} to {city} just in time."
msgstr "ГГС: Браво пассажиру, который в последний миг успел на рейс {airline} в {city}."

msgctxt "pa"
msgid "PA: Bravo to the passenger who caught {flight} at Gate {gate} just in time."
msgstr "ГГС: Браво пассажиру, который в последний миг успел на рейс {flight} у выхода {gate}."

msgctxt "pa"
msgid "PA: Bravo to the passenger who caught {flight} with seconds to spare."
msgstr "ГГС: Браво пассажиру, который успел на рейс {flight} за считанные секунды до вылета."

msgctxt "pa"
msgid "PA: Our terminal is now rated {stars} stars. Same carpet, slightly prouder management."
msgstr "ГГС: Рейтинг нашего терминала теперь {stars} зв. Тот же ковёр, но чуть более гордое руководство."

msgid "Ramp agents"
msgstr "Перронная служба"

msgid "Ramp agent needed for baggage"
msgstr "Для багажа нужен сотрудник перронной службы"

msgid "No ramp agents hired · hire one on Staff"
msgstr "Нет сотрудников перронной службы · наймите в «Персонале»"

msgid "All ramp agents busy · hire another on Staff"
msgstr "Все сотрудники перронной службы заняты · наймите ещё в «Персонале»"

msgid "Ramp agent needed for pushback"
msgstr "Для буксировки нужен сотрудник перронной службы"

msgid "Emergency tug called (-{fee}) · Hire a ramp agent on Staff"
msgstr "Вызван аварийный тягач (-{fee}) · Наймите сотрудника перронной службы"

