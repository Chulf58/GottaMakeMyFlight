msgid "Search table"
msgstr "Стол досмотра"

msgctxt "build menu"
msgid "Confiscation bin"
msgstr "Контейнер изъятия"

msgctxt "item name"
msgid "Search table"
msgstr "Стол досмотра"

msgctxt "item name"
msgid "Confiscation bin"
msgstr "Контейнер изъятия"

msgid "An inspection table where officers check flagged carry-on bags."
msgstr "Стол, где сотрудники досматривают отмеченную ручную кладь."

msgid "Place it beside the lane's side berth. Optional: the lane works without one."
msgstr "Ставится у бокового места линии досмотра. Необязательно: линия работает и без него."

msgid "No upkeep. Holds the passenger's tray during bag searches."
msgstr "Без содержания. Держит лоток пассажира во время проверки сумки."

msgid "A clear glass bin showing items taken at the security lane today."
msgstr "Прозрачный стеклянный контейнер, показывающий вещи, изъятые на линии сегодня."

msgid "Place it next to the search table slot. Resets at midnight."
msgstr "Ставится рядом со слотом стола досмотра. Очищается в полночь."

msgid "No upkeep. Inspect it to see today's strangest finds."
msgstr "Без содержания. Осмотрите его, чтобы увидеть самые странные находки дня."

msgid "Status: Attached to a ready security lane"
msgstr "Статус: подключено к готовой линии досмотра"

msgid "Status: Not attached to a ready lane"
msgstr "Статус: не подключено к готовой линии"

msgid "Confiscated today: {count} item"
msgid_plural "Confiscated today: {count} items"
msgstr[0] "Изъято сегодня: {count} предмет"
msgstr[1] "Изъято сегодня: {count} предмета"
msgstr[2] "Изъято сегодня: {count} предметов"

msgid "{item} ({quip})"
msgstr "{item} ({quip})"

msgid "Recent: {items}"
msgstr "Недавнее: {items}"

msgid "Giant alpine snow globe"
msgstr "Огромный альпийский снежный шар"

msgid "Contains 400 ml of festive winter magic."
msgstr "Внутри 400 мл праздничной зимней магии."

msgid "Souvenir city snow globe"
msgstr "Сувенирный городской снежный шар"

msgid "Too much decorative blizzard for cabin altitude."
msgstr "Слишком много декоративной метели для салона самолёта."

msgid "Musical penguin snow globe"
msgstr "Музыкальный снежный шар с пингвином"

msgid "Shakes nicely, still over the 100 ml limit."
msgstr "Трясётся отлично, но всё равно превышает лимит в 100 мл."

msgid "Family-size maple syrup jug"
msgstr "Семейная канистра кленового сиропа"

msgid "Emergency pancake rations are still a liquid."
msgstr "Запас блинчиков на чёрный день всё равно считается жидкостью."

msgid "Artisanal pancake syrup"
msgstr "Ремесленный сироп для блинов"

msgid "Declared as breakfast insurance."
msgstr "Задекларирован как «страховка на завтрак»."

msgid "Emergency waffle syrup"
msgstr "Аварийный сироп для вафель"

msgid "Sticky situation in tray three."
msgstr "Липкая история на третьем лотке."

msgid "Ceramic garden gnome"
msgstr "Керамический садовый гном"

msgid "Claimed to be a tiny travel companion."
msgstr "Пассажир уверял, что это «мини-попутчик»."

msgid "Uncle Barnaby's lucky gnome"
msgstr "Счастливый гном дяди Барнаби"

msgid "Too heavy for the overhead bin."
msgstr "Слишком тяжёлый для верхней полки."

msgid "Pointy-hat lawn gnome"
msgstr "Садовый гном в остроконечном колпаке"

msgid "Refused to fit in a quart-size zip bag."
msgstr "Наотрез отказался влезать в литровый пакет."

msgid "Twelve-pound bowling ball"
msgstr "Шар для боулинга на 12 фунтов"

msgid "Definitely not a compact neck pillow."
msgstr "Точно не похож на компактную подушку для шеи."

